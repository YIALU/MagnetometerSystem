<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <SolidColorBrush x:Key="WorkspaceBackground" Color="#F3F6FA"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#DCE3ED"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#586A80"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#205DC4"/>
        <Style TargetType="Window"><Setter Property="Background" Value="{DynamicResource WorkspaceBackground}"/><Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei"/><Setter Property="FontSize" Value="13"/></Style>
        <Style x:Key="WorkspacePanel" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="11,6"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Foreground" Value="#22354D"/><Setter Property="MinHeight" Value="30"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="6,4"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="5,4"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="Expander"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
        <Style TargetType="GroupBox"><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/></Style>
</ResourceDictionary>
