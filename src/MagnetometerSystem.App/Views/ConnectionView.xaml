<UserControl x:Class="MagnetometerSystem.App.Views.ConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:MagnetometerSystem.Core.Models;assembly=MagnetometerSystem.Core"
             xmlns:protocol="clr-namespace:MagnetometerSystem.Core.Protocol;assembly=MagnetometerSystem.Core"
             xmlns:controls="clr-namespace:MagnetometerSystem.App.Controls"
             xmlns:vm="clr-namespace:MagnetometerSystem.App.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             Background="{DynamicResource EnclosureBrush}">
    <!-- 连接页：连接参数只在这里编辑。DataContext = ConnectionViewModel。 -->
    <UserControl.Resources>
        <ObjectDataProvider x:Key="FieldDataTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters><x:Type TypeName="models:FieldDataType"/></ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ChecksumAlgorithmValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters><x:Type TypeName="models:ChecksumAlgorithm"/></ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="Crc16VariantValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters><x:Type TypeName="protocol:Crc16Variant"/></ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- 仅在某种段类型下可见 -->
        <Style x:Key="OnlyHexSeg" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:SegmentType.Header}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:SegmentType.Tail}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:SegmentType.Padding}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OnlyData" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:SegmentType.DataField}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NotData" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:SegmentType.DataField}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OnlyPadding" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:SegmentType.Padding}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OnlyLength" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:SegmentType.LengthField}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OnlyChecksum" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:SegmentType.Checksum}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OnlyCrc16" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Type}" Value="{x:Static models:SegmentType.Checksum}"/>
                        <Condition Binding="{Binding ChecksumAlgorithm}" Value="{x:Static models:ChecksumAlgorithm.CRC16}"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BinaryOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProtocolConfig.Category}" Value="{x:Static models:ProtocolCategory.Binary}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AsciiOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProtocolConfig.Category}" Value="{x:Static models:ProtocolCategory.Ascii}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== 左：连接与采集信息 ===================== -->
        <Border Style="{StaticResource Panel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,14,16,16">
                    <TextBlock Text="连接" Style="{StaticResource PanelTitle}" Margin="0,0,0,12"/>
                    <Border Style="{StaticResource SegmentGroup}" Margin="0,0,0,14" IsEnabled="{Binding IsAcquiring, Converter={StaticResource InverseBool}}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentItem}" Content="串口" MinWidth="70"
                                         IsChecked="{Binding SelectedConnectionType, Converter={StaticResource EnumToBool}, ConverterParameter=Serial}"/>
                            <RadioButton Style="{StaticResource SegmentItem}" Content="TCP" MinWidth="70"
                                         IsChecked="{Binding SelectedConnectionType, Converter={StaticResource EnumToBool}, ConverterParameter=Tcp}"/>
                        </StackPanel>
                    </Border>

                    <!-- 串口参数 -->
                    <StackPanel IsEnabled="{Binding IsAcquiring, Converter={StaticResource InverseBool}}"
                                Visibility="{Binding SelectedConnectionType, Converter={StaticResource DockTabVisible}, ConverterParameter=Serial}">
                        <TextBlock Text="串口" Style="{StaticResource FieldLabel}"/>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshPortsCommand}" Margin="6,0,0,0" ToolTip="重新扫描可用串口"/>
                            <ComboBox ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}" IsEditable="True"
                                      Text="{Binding SelectedPort, UpdateSourceTrigger=LostFocus}"/>
                        </DockPanel>
                        <TextBlock Text="波特率" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding BaudRates}" SelectedItem="{Binding BaudRate}" IsEditable="True"
                                  Text="{Binding BaudRate, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="数据位" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding DataBitsOptions}" SelectedItem="{Binding DataBits}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="校验位" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Parities}" SelectedItem="{Binding Parity}">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource ParityName}}"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="停止位" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding StopBits}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- TCP 参数 -->
                    <StackPanel IsEnabled="{Binding IsAcquiring, Converter={StaticResource InverseBool}}"
                                Visibility="{Binding SelectedConnectionType, Converter={StaticResource DockTabVisible}, ConverterParameter=Tcp}">
                        <TextBlock Text="IP 地址" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource MonoTextBox}" Text="{Binding IpAddress, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10"/>
                        <TextBlock Text="端口" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource MonoTextBox}" Text="{Binding Port, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="TCP 断线会自动重连；重连期间会话保持打开，也不能回放。"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Foreground="{DynamicResource WarnBrush}"
                               Text="采集进行中，停止后才能修改连接参数和协议。"
                               Visibility="{Binding IsAcquiring, Converter={StaticResource BoolToVis}}"/>

                    <Rectangle Height="1" Fill="{DynamicResource Line2Brush}" Margin="0,16"/>

                    <TextBlock Text="采集信息" Style="{StaticResource PanelTitle}" Margin="0,0,0,12"/>
                    <TextBlock Text="标称采样率 (Hz)" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding PresetSampleRates}" SelectedItem="{Binding SampleRate}" IsEditable="True"
                              Text="{Binding SampleRate, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,6"
                              IsEnabled="{Binding IsAcquiring, Converter={StaticResource InverseBool}}"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="只作为会话记录保存，不会向设备发送命令，也不改变时间轴。设备实际输出频率显示在顶部「解析 · 实测」，修改设备频率请在「命令」页发送命令。"/>

                    <Rectangle Height="1" Fill="{DynamicResource Line2Brush}" Margin="0,16"/>

                    <TextBlock Text="协议库" Style="{StaticResource PanelTitle}" Margin="0,0,0,12"/>
                    <ComboBox ItemsSource="{Binding SavedProtocols}" SelectedItem="{Binding SelectedSavedProtocol}" DisplayMemberPath="Name" Margin="0,0,0,8"/>
                    <WrapPanel IsEnabled="{Binding IsAcquiring, Converter={StaticResource InverseBool}}">
                        <Button Content="载入所选" Style="{StaticResource PrimaryButton}" Command="{Binding LoadSelectedProtocolCommand}" Margin="0,0,6,6"/>
                        <Button Content="保存当前" Command="{Binding SaveProtocolCommand}" Margin="0,0,6,6"/>
                        <Button Content="导入…" Command="{Binding ImportProtocolCommand}" Margin="0,0,6,6"/>
                        <Button Content="导出…" Command="{Binding ExportProtocolCommand}" Margin="0,0,6,6"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Text="协议决定通道数量、名称和单位；内置命令随协议切换。协议文件为 JSON，可导出后分享。"/>
                    <Border Style="{StaticResource Callout}" Margin="0,12,0,0" Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource Ink2Brush}"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===================== 右：协议编辑 + 解析测试 ===================== -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                    <StackPanel IsEnabled="{Binding IsAcquiring, Converter={StaticResource InverseBool}}">
                        <Border Style="{StaticResource PanelHeader}" Padding="16,0">
                            <DockPanel VerticalAlignment="Center">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                           Visibility="{Binding ProtocolConfig.Category, Converter={StaticResource DockTabVisible}, ConverterParameter=Binary}">
                                    <Run Text="帧长 "/><Run Text="{Binding TotalFrameLength, Mode=OneWay}" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource InkBrush}"/><Run Text=" 字节"/>
                                </TextBlock>
                                <TextBlock Text="协议" Style="{StaticResource PanelTitle}"/>
                            </DockPanel>
                        </Border>
                        <StackPanel Margin="16,14,16,16">
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="名称" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ProtocolConfig.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="格式" Style="{StaticResource FieldLabel}"/>
                                    <Border Style="{StaticResource SegmentGroup}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource SegmentItem}" Content="ASCII 文本"
                                                         IsChecked="{Binding ProtocolConfig.Category, Converter={StaticResource EnumToBool}, ConverterParameter=Ascii}"/>
                                            <RadioButton Style="{StaticResource SegmentItem}" Content="二进制"
                                                         IsChecked="{Binding ProtocolConfig.Category, Converter={StaticResource EnumToBool}, ConverterParameter=Binary}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- ===== ASCII ===== -->
                            <StackPanel Style="{StaticResource AsciiOnly}">
                                <WrapPanel Margin="0,0,0,12">
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="分隔符" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Width="90" Style="{StaticResource MonoTextBox}" Text="{Binding ProtocolConfig.AsciiDelimiter, UpdateSourceTrigger=LostFocus}"/>
                                    </StackPanel>
                                    <CheckBox Content="首行为表头（跳过）" IsChecked="{Binding ProtocolConfig.AsciiHasHeader}" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                </WrapPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="+ 字段" Style="{StaticResource SmallButton}" Command="{Binding AddFieldMappingCommand}"/>
                                    <TextBlock Text="字段（每行按分隔符切分后取第 N 列）" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding ProtocolConfig.FieldMappings}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          MaxHeight="300" FontSize="12">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="通道序号" Binding="{Binding ChannelIndex}" Width="70"/>
                                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="70"/>
                                        <DataGridTextColumn Header="列号" Binding="{Binding ByteOffset}" Width="60"/>
                                        <DataGridTextColumn Header="缩放" Binding="{Binding Scale}" Width="70"/>
                                        <DataGridTextColumn Header="偏移量" Binding="{Binding Offset}" Width="70"/>
                                        <DataGridTemplateColumn Width="56">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="删除" Style="{StaticResource SmallGhostButton}" Foreground="{DynamicResource ErrBrush}"
                                                            Command="{Binding DataContext.RemoveFieldMappingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>

                            <!-- ===== 二进制 ===== -->
                            <StackPanel Style="{StaticResource BinaryOnly}">
                                <TextBlock Text="帧结构" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding ProtocolConfig.Notes}" TextWrapping="Wrap" Foreground="{DynamicResource WarnBrush}" Margin="0,0,0,6"
                                           Visibility="{Binding ProtocolConfig.Notes, Converter={StaticResource NullToCollapsed}}"/>
                                <!-- 字节图：宽度按字节数比例 -->
                                <ItemsControl ItemsSource="{Binding ProtocolSegments}" Margin="0,0,0,6" Height="46">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><controls:WeightPanel MinItemWidth="38"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:FrameSegment}">
                                            <Border controls:WeightPanel.Weight="{Binding ByteCount}" Margin="0,0,2,0" CornerRadius="3" Padding="4,3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="ToolTip" Value="{Binding Name}"/>
                                                        <Setter Property="Background" Value="{DynamicResource Panel3Brush}"/>
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Ink2Brush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:SegmentType.Header}">
                                                                <Setter Property="Background" Value="{DynamicResource Graphite3Brush}"/>
                                                                <Setter Property="TextElement.Foreground" Value="White"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:SegmentType.Tail}">
                                                                <Setter Property="Background" Value="{DynamicResource Graphite3Brush}"/>
                                                                <Setter Property="TextElement.Foreground" Value="White"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:SegmentType.DataField}">
                                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:SegmentType.Checksum}">
                                                                <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}"/>
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource WarnBrush}"/>
                                                            </DataTrigger>
                                                            <!-- 未启用的校验段只占位：与填充段同色，提示里说明 -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Type}" Value="{x:Static models:SegmentType.Checksum}"/>
                                                                    <Condition Binding="{Binding ChecksumEnabled}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Background" Value="{DynamicResource Panel3Brush}"/>
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource MutedBrush}"/>
                                                                <Setter Property="ToolTip" Value="校验未启用：这几个字节只占位，不比对"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ByteCount, StringFormat={}{0} B}" FontSize="10.5" FontFamily="{DynamicResource MonoFont}" HorizontalAlignment="Center" Opacity=".8"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                           Text="宽度按字节数比例。解析器按帧头找帧，校验或固定值不符时丢弃并重新同步，分包、粘包会自动拼接。"/>

                                <!-- 段表 -->
                                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4">
                                    <StackPanel>
                                        <Grid Background="{DynamicResource Panel2Brush}" Height="30">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/><ColumnDefinition Width="110"/><ColumnDefinition Width="56"/><ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="104"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="类型" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Ink2Brush}"/>
                                            <TextBlock Grid.Column="1" Text="名称" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Ink2Brush}"/>
                                            <TextBlock Grid.Column="2" Text="字节" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Ink2Brush}"/>
                                            <TextBlock Grid.Column="3" Text="偏移" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Ink2Brush}"/>
                                            <TextBlock Grid.Column="4" Text="内容" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Ink2Brush}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding ProtocolSegments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:FrameSegment}">
                                                    <Grid MinHeight="40">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="56"/><ColumnDefinition Width="110"/><ColumnDefinition Width="56"/><ColumnDefinition Width="52"/>
                                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="104"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.ColumnSpan="6" BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,1,0,0"/>
                                                        <TextBlock Text="{Binding Type, Converter={StaticResource EnumDisplay}}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="1" Style="{StaticResource CellTextBox}" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding ByteCount}" FontFamily="{DynamicResource MonoFont}" Margin="4,0" Style="{StaticResource OnlyData}"
                                                                       ToolTip="由数据类型决定"/>
                                                            <TextBox Text="{Binding ByteCount, UpdateSourceTrigger=LostFocus}" FontFamily="{DynamicResource MonoFont}" Style="{StaticResource CellTextBox}">
                                                                <TextBox.Visibility>
                                                                    <Binding Path="Type" Converter="{StaticResource EnumVisible}" ConverterParameter="!DataField"/>
                                                                </TextBox.Visibility>
                                                            </TextBox>
                                                        </Grid>
                                                        <TextBlock Grid.Column="3" Text="{Binding ComputedOffset}" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                                                        <WrapPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,4">
                                                            <!-- 帧头 / 帧尾 / 填充：十六进制固定值 -->
                                                            <TextBox Width="140" Style="{StaticResource MonoTextBox}" CharacterCasing="Upper" Margin="0,0,8,0"
                                                                     Text="{Binding FixedHexValue, UpdateSourceTrigger=LostFocus}" ToolTip="十六进制值，按字节数截断或补零">
                                                                <TextBox.Visibility><Binding Path="Type" Converter="{StaticResource EnumVisible}" ConverterParameter="Header,Tail,Padding"/></TextBox.Visibility>
                                                            </TextBox>
                                                            <CheckBox Content="参与帧同步校验" IsChecked="{Binding ValidateFixedValue}" Style="{StaticResource OnlyPadding}"
                                                                      ToolTip="固定值（如信息 ID）不符时丢弃该帧，降低载荷中偶然出现帧头造成的误锁帧"/>
                                                            <!-- 数据 -->
                                                            <StackPanel Orientation="Horizontal" Style="{StaticResource OnlyData}">
                                                                <ComboBox Width="84" ItemsSource="{Binding Source={StaticResource FieldDataTypeValues}}" SelectedItem="{Binding DataType}" Margin="0,0,8,0"/>
                                                                <CheckBox Content="大端" IsChecked="{Binding BigEndian}" Margin="0,0,10,0"/>
                                                                <TextBlock Text="通道" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource MutedBrush}"/>
                                                                <TextBox Width="36" Style="{StaticResource MonoTextBox}" Text="{Binding ChannelIndex, UpdateSourceTrigger=LostFocus}" Margin="0,0,10,0"/>
                                                                <TextBlock Text="× " VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                                                                <TextBox Width="56" Style="{StaticResource MonoTextBox}" Text="{Binding Scale, UpdateSourceTrigger=LostFocus}" ToolTip="缩放"/>
                                                                <TextBlock Text=" + " VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                                                                <TextBox Width="56" Style="{StaticResource MonoTextBox}" Text="{Binding Offset, UpdateSourceTrigger=LostFocus}" Margin="0,0,10,0" ToolTip="偏移量"/>
                                                                <TextBlock Text="单位" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource MutedBrush}"/>
                                                                <TextBox Width="54" Text="{Binding Unit, UpdateSourceTrigger=LostFocus}"/>
                                                            </StackPanel>
                                                            <!-- 长度 -->
                                                            <CheckBox Content="大端序" IsChecked="{Binding LengthBigEndian}" Style="{StaticResource OnlyLength}"
                                                                      ToolTip="长度值表示数据区字节数"/>
                                                            <!-- 校验：先决定是否比对，后面是参数 -->
                                                            <StackPanel Orientation="Horizontal" Style="{StaticResource OnlyChecksum}">
                                                                <CheckBox Content="启用校验" IsChecked="{Binding ChecksumEnabled}" Margin="0,0,12,0" VerticalAlignment="Center"
                                                                          ToolTip="不勾选：帧里预留了校验字段、但固件没有计算时使用。这几个字节照常占位，解析时不比对；右侧参数保留，勾选后立即生效。"/>
                                                                <ComboBox Width="96" ItemsSource="{Binding Source={StaticResource ChecksumAlgorithmValues}}" SelectedItem="{Binding ChecksumAlgorithm}"
                                                                          ItemTemplate="{StaticResource EnumItemTemplate}" Margin="0,0,8,0"/>
                                                                <TextBlock Text="起始段" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource MutedBrush}"/>
                                                                <TextBox Width="40" Style="{StaticResource MonoTextBox}" Text="{Binding ChecksumStartIndex, UpdateSourceTrigger=LostFocus}" Margin="0,0,8,0"
                                                                         ToolTip="校验从第几段开始计算（段序号从 0 开始，到校验段之前为止）。须按固件协议确认。"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Style="{StaticResource OnlyCrc16}">
                                                                <ComboBox Width="100" ItemsSource="{Binding Source={StaticResource Crc16VariantValues}}" SelectedItem="{Binding Crc16Variant}" Margin="0,0,8,0"
                                                                          ToolTip="CRC-16 变体，必须与设备端一致"/>
                                                                <CheckBox Content="大端" IsChecked="{Binding ChecksumBigEndian}"
                                                                          ToolTip="勾选 = 高字节在前；不勾 = 低字节在前（Modbus RTU 习惯）"/>
                                                            </StackPanel>
                                                        </WrapPanel>
                                                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0">
                                                            <Button Content="↑" Style="{StaticResource IconButton}" ToolTip="上移"
                                                                    Command="{Binding DataContext.MoveSegmentUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                            <Button Content="↓" Style="{StaticResource IconButton}" ToolTip="下移"
                                                                    Command="{Binding DataContext.MoveSegmentDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                            <Button Content="删除" Style="{StaticResource SmallGhostButton}" Foreground="{DynamicResource ErrBrush}"
                                                                    Command="{Binding DataContext.RemoveSegmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <WrapPanel Margin="0,10,0,0">
                                    <TextBlock Text="添加段" VerticalAlignment="Center" Margin="0,0,8,6" Foreground="{DynamicResource Ink2Brush}"/>
                                    <Button Content="+ 帧头" Style="{StaticResource SmallButton}" Margin="0,0,6,6" Command="{Binding AddSegmentCommand}" CommandParameter="{x:Static models:SegmentType.Header}"/>
                                    <Button Content="+ 长度" Style="{StaticResource SmallButton}" Margin="0,0,6,6" Command="{Binding AddSegmentCommand}" CommandParameter="{x:Static models:SegmentType.LengthField}"/>
                                    <Button Content="+ 数据" Style="{StaticResource SmallButton}" Margin="0,0,6,6" Command="{Binding AddSegmentCommand}" CommandParameter="{x:Static models:SegmentType.DataField}"/>
                                    <Button Content="+ 校验" Style="{StaticResource SmallButton}" Margin="0,0,6,6" Command="{Binding AddSegmentCommand}" CommandParameter="{x:Static models:SegmentType.Checksum}"/>
                                    <Button Content="+ 帧尾" Style="{StaticResource SmallButton}" Margin="0,0,6,6" Command="{Binding AddSegmentCommand}" CommandParameter="{x:Static models:SegmentType.Tail}"/>
                                    <Button Content="+ 填充 / 固定值" Style="{StaticResource SmallButton}" Margin="0,0,6,6" Command="{Binding AddSegmentCommand}" CommandParameter="{x:Static models:SegmentType.Padding}"/>
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== 解析测试 ===== -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <Border Style="{StaticResource PanelHeader}" Padding="16,0">
                            <DockPanel VerticalAlignment="Center">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SegmentGroup}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SegmentItem}" Content="HEX"
                                                     IsChecked="{Binding ParseTestKind, Converter={StaticResource EnumToBool}, ConverterParameter=Hex}"/>
                                        <RadioButton Style="{StaticResource SegmentItem}" Content="文本"
                                                     IsChecked="{Binding ParseTestKind, Converter={StaticResource EnumToBool}, ConverterParameter=Text}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource PanelTitle}"><Run Text="解析测试"/><Run Text="　不连接设备，用上面的协议试解析一段数据" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}"/></TextBlock>
                            </DockPanel>
                        </Border>
                        <StackPanel Margin="16,12,16,16">
                            <TextBox Style="{StaticResource MonoTextBox}" Text="{Binding ParseTestInput, UpdateSourceTrigger=PropertyChanged}" Height="96"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="8,6" VerticalScrollBarVisibility="Auto"
                                     ToolTip="HEX：空格分隔的字节，可带 0x；文本：可用 \r \n \t 表示控制字符"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
                                <Button Content="解析" Style="{StaticResource PrimaryButton}" Command="{Binding RunParseTestCommand}" MinWidth="72" Margin="0,0,6,0"/>
                                <Button Content="用最近收到的数据" Command="{Binding FillParseTestFromRecentCommand}"/>
                            </StackPanel>
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Callout}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ParseTestIsError}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}"/>
                                                <Setter Property="BorderBrush" Value="#EBD6A6"/>
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource WarnBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <WrapPanel Visibility="{Binding ParseTestResult, Converter={StaticResource NullToCollapsed}}" Margin="0,0,0,6">
                                        <Border Style="{StaticResource OkBadge}" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding ParseTestResult.Frames.Count, StringFormat='找到 {0} 帧'}" FontSize="12"/>
                                        </Border>
                                        <Border Style="{StaticResource ErrBadge}" Margin="0,0,6,0"
                                                Visibility="{Binding ParseTestResult.RejectedCount, Converter={StaticResource NonZeroToVisibility}}">
                                            <TextBlock Text="{Binding ParseTestResult.RejectedCount, StringFormat='拒绝并重新同步 {0} 次'}" FontSize="12"/>
                                        </Border>
                                        <Border Style="{StaticResource Badge}">
                                            <TextBlock Text="{Binding ParseTestResult.InputByteCount, StringFormat='输入 {0} 字节'}" FontSize="12"/>
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding ParseTestMessage}" TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{Binding ParseTestResult.Errors}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding StringFormat='· {0}'}" Foreground="{DynamicResource ErrBrush}" TextWrapping="Wrap" FontSize="12"/></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <!-- 解析过程：与采集页“原始报文”相同的逐帧记录 -->
                            <StackPanel Margin="0,10,0,0" Visibility="{Binding HasParseTestRecords, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="解析过程" Style="{StaticResource FieldLabel}"/>
                                <ItemsControl ItemsSource="{Binding ParseTestRecords}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ParseRecordRow}">
                                            <DockPanel Margin="0,2">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding SizeText}" Width="130" FontFamily="{DynamicResource MonoFont}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                                                <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level}" Value="err"><Setter Property="Foreground" Value="{DynamicResource ErrBrush}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="warn"><Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <TextBlock.ToolTip>
                                                        <TextBlock Text="{Binding Record.Preview, TargetNullValue=（无预览）}" FontFamily="{DynamicResource MonoFont}"/>
                                                    </TextBlock.ToolTip>
                                                </TextBlock>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding ParseTestRows}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ParseTestRow}">
                                        <DockPanel Margin="0,3">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Index, StringFormat='第 {0} 帧'}" Width="64" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                            <TextBlock Text="{Binding Text}" FontFamily="{DynamicResource MonoFont}" FontSize="12" TextWrapping="Wrap"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
