<UserControl x:Class="MagnetometerSystem.App.Views.AnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:vm="clr-namespace:MagnetometerSystem.App.ViewModels"
             xmlns:storage="clr-namespace:MagnetometerSystem.Core.Storage;assembly=MagnetometerSystem.Core"
             Background="{DynamicResource EnclosureBrush}">
    <!-- 独立数据分析页（REQ-005）。只读已保存会话，不写入任何数据。DataContext = AnalysisViewModel。 -->
    <UserControl.Resources>
        <Style x:Key="Th" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Td" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <!-- 结果表列宽：名称 + 9 个数值列 -->
        <Style x:Key="ResultGrid" TargetType="Grid">
            <Setter Property="Height" Value="34"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 设置 ===== -->
        <Border Style="{StaticResource Panel}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                    <TextBlock Text="分析设置" Style="{StaticResource PanelTitle}"/>
                </Border>
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,1,0,0" Padding="14,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="开始分析" Style="{StaticResource PrimaryButton}" Command="{Binding RunCommand}" MinWidth="96" Margin="0,0,6,0"/>
                            <Button Content="取消" Command="{Binding CancelCommand}" Margin="0,0,6,0"/>
                            <Button Content="导出结果…" Command="{Binding ExportCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource ErrBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,12,14,12" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="刷新" Style="{StaticResource SmallGhostButton}" Command="{Binding RefreshSessionsCommand}"/>
                            <TextBlock Text="会话" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0"/>
                        </DockPanel>
                        <ComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type storage:SessionInfo}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}">
                                            <Run Text="{Binding StartedAt, Mode=OneWay, StringFormat=yyyy-MM-dd HH:mm}"/><Run Text="　"/><Run Text="{Binding TotalReadings, Mode=OneWay, StringFormat={}{0:N0} 条}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding SessionSpanText}" Style="{StaticResource Hint}" Margin="0,6,0,14"/>

                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="全选 / 全不选" Style="{StaticResource SmallGhostButton}" Command="{Binding SelectAllChannelsCommand}"/>
                            <TextBlock Text="通道（名称与单位来自会话）" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0"/>
                        </DockPanel>
                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" MaxHeight="220" Margin="0,0,0,14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Channels}" Margin="8,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:AnalysisChannelOption}">
                                            <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" Margin="0,4"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Text="时间段（相对会话开始的秒数，留空 = 全部）" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource MonoTextBox}" Text="{Binding RangeStartText, UpdateSourceTrigger=PropertyChanged}" ToolTip="起点，秒"/>
                            <TextBlock Grid.Column="1" Text="至" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBox Grid.Column="2" Style="{StaticResource MonoTextBox}" Text="{Binding RangeEndText, UpdateSourceTrigger=PropertyChanged}" ToolTip="终点，秒"/>
                        </Grid>

                        <TextBlock Text="短时噪声" Style="{StaticResource SectionTitle}"/>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Right" Text="s" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBox DockPanel.Dock="Right" Width="80" Style="{StaticResource MonoTextBox}" TextAlignment="Right" Text="{Binding NoiseWindowSeconds, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="窗口长度" VerticalAlignment="Center"/>
                        </DockPanel>
                        <CheckBox Content="窗口内去除线性趋势（否则只去均值）" IsChecked="{Binding DetrendNoiseWindows}" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                                   Text="按实际时间切成不重叠窗口，每个窗口求残差标准差；结果取各窗口的中位数和最大值。"/>

                        <TextBlock Text="长时漂移" Style="{StaticResource SectionTitle}"/>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Right" Text="s" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBox DockPanel.Dock="Right" Width="80" Style="{StaticResource MonoTextBox}" TextAlignment="Right" Text="{Binding DriftSegmentSeconds, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="分段长度" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="漂移速率是全部有效点对实际时间的最小二乘斜率（单位 / 小时）；分段均值的极差反映慢变化幅度。"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== 结果 ===== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MaxHeight="300"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Panel}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <DockPanel VerticalAlignment="Center">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" Text="使用原始读数（协议解析后、校正前）；点击一行查看曲线。" VerticalAlignment="Center"/>
                            <TextBlock Text="结果" Style="{StaticResource PanelTitle}"/>
                        </DockPanel>
                    </Border>
                    <Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="16" Text="还没有结果。在左侧选择会话、通道和时间段后开始分析。"
                                   Visibility="{Binding Results.Count, Converter={StaticResource ZeroToVisible}}"/>
                        <DockPanel Visibility="{Binding Results.Count, Converter={StaticResource NonZeroToVisibility}}">
                            <Grid DockPanel.Dock="Top" Background="{DynamicResource Panel2Brush}" MinHeight="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="通道" Style="{StaticResource Th}" TextAlignment="Left" Margin="14,0,0,0"/>
                                <TextBlock Grid.Column="1" Text="有效点" Style="{StaticResource Th}"/>
                                <TextBlock Grid.Column="2" Text="实际频率 Hz" Style="{StaticResource Th}"/>
                                <TextBlock Grid.Column="3" Text="缺失" Style="{StaticResource Th}"/>
                                <TextBlock Grid.Column="4" Text="均值" Style="{StaticResource Th}"/>
                                <TextBlock Grid.Column="5" Text="标准差" Style="{StaticResource Th}"/>
                                <TextBlock Grid.Column="6" Text="漂移 /h" Style="{StaticResource Th}"/>
                                <TextBlock Grid.Column="7" Text="去趋势 σ" Style="{StaticResource Th}"/>
                                <TextBlock Grid.Column="8" Text="噪声 σ 中位" Style="{StaticResource Th}"/>
                                <TextBlock Grid.Column="9" Text="分段极差" Style="{StaticResource Th}" Margin="0,0,14,0"/>
                            </Grid>
                            <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding FocusedResult}" ItemContainerStyle="{StaticResource FlatListItem}"
                                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AnalysisResultRow}">
                                        <StackPanel>
                                            <Grid Style="{StaticResource ResultGrid}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.4*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{Binding Unit, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}"/>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Style="{StaticResource Td}" Text="{Binding Result.Quality.SampleCount, StringFormat=N0}"/>
                                                <TextBlock Grid.Column="2" Style="{StaticResource Td}" Text="{Binding Result.Quality.ActualRateHz, StringFormat={}{0:0.###}}"/>
                                                <TextBlock Grid.Column="3" Style="{StaticResource Td}" Text="{Binding Result.Quality.GapCount}"/>
                                                <TextBlock Grid.Column="4" Style="{StaticResource Td}" Text="{Binding Result.Mean, StringFormat={}{0:F3}}"/>
                                                <TextBlock Grid.Column="5" Style="{StaticResource Td}" Text="{Binding Result.StdDev, StringFormat={}{0:F4}}"/>
                                                <TextBlock Grid.Column="6" Style="{StaticResource Td}" Text="{Binding Result.DriftPerHour, StringFormat={}{0:F4}}"/>
                                                <TextBlock Grid.Column="7" Style="{StaticResource Td}" Text="{Binding Result.DetrendedStdDev, StringFormat={}{0:F4}}"/>
                                                <TextBlock Grid.Column="8" Style="{StaticResource Td}" Text="{Binding Result.NoiseMedianStd, StringFormat={}{0:F4}}"/>
                                                <TextBlock Grid.Column="9" Style="{StaticResource Td}" Text="{Binding Result.SegmentMeanSpread, StringFormat={}{0:F4}}" Margin="0,0,14,0"/>
                                            </Grid>
                                            <TextBlock Text="{Binding WarningText}" Foreground="{DynamicResource WarnBrush}" FontSize="12" Margin="14,0,14,8" TextWrapping="Wrap"
                                                       Visibility="{Binding WarningText, Converter={StaticResource NullToCollapsed}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Panel}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <DockPanel VerticalAlignment="Center">
                            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ShowSeries" Style="{StaticResource SegmentItem}" Content="时域与趋势" IsChecked="True" Checked="OnChartModeChanged"/>
                                    <RadioButton x:Name="ShowNoise" Style="{StaticResource SegmentItem}" Content="噪声窗口" Checked="OnChartModeChanged"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource PanelTitle}">
                                <Run Text="{Binding FocusedResult.Name, Mode=OneWay, TargetNullValue=曲线}"/><Run Text="  "/><Run Text="{Binding FocusedResult.Unit, Mode=OneWay}" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}"/>
                            </TextBlock>
                        </DockPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="14,0,14,10" Text="{Binding AnalysisSettingsText}"/>
                    <scottplot:WpfPlot x:Name="Plot" Margin="4"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
