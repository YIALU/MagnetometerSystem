<UserControl x:Class="MagnetometerSystem.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MagnetometerSystem.App"
             Background="{DynamicResource EnclosureBrush}">
    <!-- 设置页：只放会生效的设置。连接参数在“连接”页；原始数据一律自动保存。 -->
    <UserControl.Resources>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,6,16,0"/>
        </Style>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Line2Brush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,18,0,20"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Panel}" Margin="12" MaxWidth="860" HorizontalAlignment="Left" Padding="28,6,28,20">
            <StackPanel>
                <!-- 存储与日志 -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="存储与日志" Style="{StaticResource PanelTitle}" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="数据库" Style="{StaticResource RowLabel}"/>
                            <StackPanel Grid.Column="1" Margin="0,0,0,14">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="打开文件夹" Command="{Binding OpenDatabaseFolderCommand}" Margin="8,0,0,0"/>
                                    <TextBox Style="{StaticResource MonoTextBox}" Text="{Binding DatabasePath, Mode=OneWay}" IsReadOnly="True"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                           Text="连接设备后原始读数自动保存到这里。旧版固定列数据保留在 legacy 表中，不会被删除。移动或备份前请先停止采集。"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="日志目录" Style="{StaticResource RowLabel}"/>
                            <DockPanel Grid.Row="1" Grid.Column="1">
                                <Button DockPanel.Dock="Right" Content="打开" Command="{Binding OpenLogFolderCommand}" Margin="8,0,0,0"/>
                                <TextBox Style="{StaticResource MonoTextBox}" Text="{Binding LogDirectory, Mode=OneWay}" IsReadOnly="True"/>
                            </DockPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 图表 -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="图表" Style="{StaticResource PanelTitle}" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="绘图刷新率" Style="{StaticResource RowLabel}"/>
                            <StackPanel Grid.Column="1" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Width="110" ItemsSource="{Binding RefreshRateOptions}" SelectedItem="{Binding ChartRefreshRate}">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0} Hz}"/></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource ErrBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="只决定曲线多久重绘一次，与设备输出频率、标称采样率无关。修改后立即生效。"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="曲线缓存" Style="{StaticResource RowLabel}" Margin="0,0,16,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap"
                                       Text="每通道保留最近 100,000 点，用于显示与区间统计。完整数据以数据库为准，长时段请用「分析」页。"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 更新 -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="更新" Style="{StaticResource PanelTitle}" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="检查更新" Style="{StaticResource RowLabel}" Margin="0,0,16,0"/>
                            <StackPanel Grid.Column="1">
                                <CheckBox Style="{StaticResource Switch}" Content="启动时检查" IsChecked="{Binding AutoCheckUpdateEnabled}"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="两次成功检查至少间隔 24 小时，需要联网；修改立即保存。也可以点导航栏底部的版本号手动检查。"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="更新平台" Style="{StaticResource RowLabel}" Margin="0,14,16,0"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,14,0,0">
                                <ComboBox ItemsSource="{Binding UpdateSources}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                          SelectedValue="{Binding UpdateSource}" Width="220" HorizontalAlignment="Left"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="自动选择可用的下载来源，并检查下载文件是否完整。只提示新版本，由您决定是否下载和安装。"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 关于 -->
                <Border Style="{StaticResource Section}" BorderThickness="0">
                    <StackPanel>
                        <TextBlock Text="关于" Style="{StaticResource PanelTitle}" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="版本" Style="{StaticResource RowLabel}" Margin="0,0,16,8"/>
                            <TextBlock Grid.Column="1" Text="{x:Static local:AppVersion.Display}" FontFamily="{DynamicResource MonoFont}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Text="安装方式" Style="{StaticResource RowLabel}" Margin="0,0,16,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Static local:AppVersion.PackageKindDisplay}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="2" Text="运行时" Style="{StaticResource RowLabel}" Margin="0,0,16,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text=".NET 8"/>
                        </Grid>
                        <Button Content="恢复默认设置" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-8,16,0,0" Command="{Binding ResetToDefaultsCommand}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
