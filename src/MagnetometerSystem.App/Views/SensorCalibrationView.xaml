<UserControl x:Class="MagnetometerSystem.App.Views.SensorCalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MagnetometerSystem.App.ViewModels"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="900">
    <!-- 偏移与增益：左侧配置列表，右侧按通道填写。DataContext = SensorCalibrationViewModel。 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 配置列表 -->
        <Border BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="刷新" Style="{StaticResource SmallGhostButton}" Command="{Binding LoadProfilesCommand}" Margin="0,0,4,0"/>
                            <Button Content="新建" Style="{StaticResource SmallButton}" Command="{Binding NewProfileCommand}"/>
                        </StackPanel>
                        <TextBlock Text="配置" Style="{StaticResource PanelTitle}"/>
                    </DockPanel>
                </Border>
                <Grid>
                    <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource FlatListItem}" SelectionChanged="OnProfileSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="14,8">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SensorSerial, TargetNullValue=未填序列号}" Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Style="{StaticResource Hint}" Margin="14" TextAlignment="Center" VerticalAlignment="Center"
                               Text="还没有偏移 / 增益配置。点「新建」开始。"
                               Visibility="{Binding Profiles.Count, Converter={StaticResource ZeroToVisible}}"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- 编辑 -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,14" MaxWidth="620" HorizontalAlignment="Left">
                <Border Style="{StaticResource Callout}" Margin="0,0,0,14">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Ink2Brush}"
                               Text="这里只保存和管理偏移 / 增益参数。目前采集、曲线显示和导出都不会自动套用这些参数。"/>
                </Border>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="配置名称" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="序列号" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding EditSensorSerial, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="传感器类型" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding SensorTypes}" SelectedItem="{Binding EditSensorType}" ItemTemplate="{StaticResource EnumItemTemplate}"/>
                    </StackPanel>
                </Grid>

                <DockPanel Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="加一个通道" Style="{StaticResource SmallGhostButton}" Command="{Binding AddChannelCommand}"/>
                        <Button Content="去掉最后一个" Style="{StaticResource SmallGhostButton}" Command="{Binding RemoveLastChannelCommand}"/>
                    </StackPanel>
                    <TextBlock Text="按通道填写（通道序号从 0 开始）" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0"/>
                </DockPanel>
                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Background="{DynamicResource Panel2Brush}" Height="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="通道" Margin="12,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Ink2Brush}"/>
                            <TextBlock Grid.Column="1" Text="偏移" Margin="8,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Ink2Brush}"/>
                            <TextBlock Grid.Column="2" Text="增益" Margin="8,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Ink2Brush}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Channels}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CalibrationChannelRow}">
                                    <Border BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,1,0,0" Padding="0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource MonoFont}" Margin="12,0" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Style="{StaticResource MonoTextBox}" Margin="4,0" Text="{Binding Offset, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox Grid.Column="2" Style="{StaticResource MonoTextBox}" Margin="4,0,8,0" Text="{Binding Gain, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="备注" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                         Height="60" VerticalContentAlignment="Top" Padding="6,4" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14"/>

                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="删除配置…" Style="{StaticResource DangerButton}" Command="{Binding DeleteProfileCommand}"/>
                    <Button Content="保存" Style="{StaticResource PrimaryButton}" MinWidth="88" Command="{Binding SaveProfileCommand}"/>
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
