<UserControl x:Class="MagnetometerSystem.App.Views.OrthogonalityCalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:MagnetometerSystem.App.Views"
             xmlns:controls="clr-namespace:MagnetometerSystem.App.Controls"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1100">
    <!-- 正交度校正向导：步骤条 + 当前步骤 + 底部上一步 / 下一步。DataContext = OrthogonalityCalibrationViewModel。 -->
    <UserControl.Resources>
        <!-- 步骤条：编号圆点 + 标题；已完成 / 当前 / 未到三种状态 -->
        <Style x:Key="StepItem" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <StackPanel Orientation="Horizontal" Margin="4,0">
                            <Border Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Panel3Brush}"/>
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Ink2Brush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Value="done">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource StepState}">
                                                        <Binding Path="CurrentStep"/>
                                                        <Binding Path="Tag" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Background" Value="{DynamicResource OkSoftBrush}"/>
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource OkBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Value="on">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource StepState}">
                                                        <Binding Path="CurrentStep"/>
                                                        <Binding Path="Tag" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="TextElement.Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{TemplateBinding Tag}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Value="done">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource StepState}">
                            <Binding Path="CurrentStep"/>
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}"/>
                </DataTrigger>
                <DataTrigger Value="on">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource StepState}">
                            <Binding Path="CurrentStep"/>
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StepLine" TargetType="Rectangle">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{DynamicResource LineBrush}"/>
        </Style>

        <!-- 统计小块 -->
        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Panel2Brush}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <!-- 矩阵 / 向量：两侧竖线，等宽数字 -->
        <Style x:Key="MatrixBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Panel2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="2,0,2,0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <DataTemplate x:Key="MatrixCell">
            <TextBlock Text="{Binding}" FontFamily="{DynamicResource MonoFont}" FontSize="13" Margin="0,2,18,2"/>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="ThreeColumns">
            <UniformGrid Columns="3"/>
        </ItemsPanelTemplate>

        <!-- 投影预览的外框 -->
        <Style x:Key="Figure" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line2Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}"/>
            <Setter Property="Padding" Value="8,6,8,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- 质量评级徽标：按 Level 着色并配文字 -->
        <Style x:Key="RatingBadge" TargetType="Border" BasedOn="{StaticResource Badge}">
            <Setter Property="Padding" Value="8,2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="ok">
                    <Setter Property="Background" Value="{DynamicResource OkSoftBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource OkBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="warn">
                    <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarnBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="err">
                    <Setter Property="Background" Value="{DynamicResource ErrSoftBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource ErrBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- ===== 步骤条 ===== -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,0,0,1" Padding="10,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding SensorSummary}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,4,0"/>
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource StepItem}" Tag="1" Content="选择传感器"/>
                    <Rectangle Style="{StaticResource StepLine}"/>
                    <ContentControl Style="{StaticResource StepItem}" Tag="2" Content="采集数据"/>
                    <Rectangle Style="{StaticResource StepLine}"/>
                    <ContentControl Style="{StaticResource StepItem}" Tag="3" Content="计算与结果"/>
                    <Rectangle Style="{StaticResource StepLine}"/>
                    <ContentControl Style="{StaticResource StepItem}" Tag="4" Content="保存配置"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== 底部：上一步 / 下一步 ===== -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,1,0,0" Padding="14,10">
            <DockPanel>
                <Button Content="上一步" MinWidth="76" Command="{Binding PreviousStepCommand}" IsEnabled="{Binding CanGoBack}"/>
                <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource MutedBrush}">
                    <Run Text="步骤 "/><Run Text="{Binding CurrentStep, Mode=OneWay}"/><Run Text=" / 4"/>
                </TextBlock>
                <Button DockPanel.Dock="Right" Content="下一步" MinWidth="88" Style="{StaticResource PrimaryButton}"
                        Command="{Binding NextStepCommand}" IsEnabled="{Binding CanGoNext}"
                        Visibility="{Binding CurrentStep, Converter={StaticResource EnumVisible}, ConverterParameter=!4}"/>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" Text="{Binding StepGateText}" VerticalAlignment="Center" Margin="12,0"/>
                <Border/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="14">
                <!-- ==================== 第 1 步：选择传感器 ==================== -->
                <StackPanel Width="440" HorizontalAlignment="Left"
                            Visibility="{Binding CurrentStep, Converter={StaticResource DockTabVisible}, ConverterParameter=1}">
                    <TextBlock Text="传感器类型" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource SegmentGroup}" Margin="0,0,0,6" IsEnabled="{Binding IsCollecting, Converter={StaticResource InverseBool}}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentItem}" Content="单三轴磁通门"
                                         IsChecked="{Binding SelectedSensorType, Converter={StaticResource EnumToBool}, ConverterParameter=TriaxialFluxgate}"/>
                            <RadioButton Style="{StaticResource SegmentItem}" Content="双三轴磁通门"
                                         IsChecked="{Binding SelectedSensorType, Converter={StaticResource EnumToBool}, ConverterParameter=DualTriaxialFluxgate}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16"
                               Text="实时或会话直接拟合：单三轴要求恰好 3 个通道，顺序 X/Y/Z；双三轴要求恰好 6 个通道，顺序 X1/Y1/Z1/X2/Y2/Z2，两组分别计算。全部通道须使用相同的明确磁场单位；含其他通道或顺序时，请整理为三轴 CSV 后导入。"/>

                    <TextBlock Text="传感器序列号（可选）" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SensorSerial, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                    <TextBlock Style="{StaticResource FieldLabel}"><Run Text="参考场强（"/><Run Text="{Binding ReferenceUnitText, Mode=OneWay}"/><Run Text="，可选）"/></TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="140" Style="{StaticResource MonoTextBox}"
                                 Text="{Binding ReferenceFieldStrength, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                        <TextBlock Text="{Binding ReferenceUnitText}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="留空时按样本自动估算；数值须使用拟合数据的单位（50,000 nT = 50 uT）。"/>
                </StackPanel>

                <!-- ==================== 第 2 步：采集数据 ==================== -->
                <Grid Visibility="{Binding CurrentStep, Converter={StaticResource DockTabVisible}, ConverterParameter=2}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*" MinWidth="360"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="数据来源" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource SegmentGroup}" Margin="0,0,0,14" IsEnabled="{Binding IsCollecting, Converter={StaticResource InverseBool}}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentItem}" Content="实时数据"
                                             IsChecked="{Binding DataSource, Converter={StaticResource EnumToBool}, ConverterParameter=Live}"/>
                                <RadioButton Style="{StaticResource SegmentItem}" Content="导入文件"
                                             IsChecked="{Binding DataSource, Converter={StaticResource EnumToBool}, ConverterParameter=File}"/>
                                <RadioButton Style="{StaticResource SegmentItem}" Content="已保存会话"
                                             IsChecked="{Binding DataSource, Converter={StaticResource EnumToBool}, ConverterParameter=Session}"/>
                            </StackPanel>
                        </Border>

                        <!-- 拟合通道：协议决定通道顺序，按名称自动识别 X / Y / Z，可以改 -->
                        <StackPanel Margin="0,0,0,14" Visibility="{Binding ShowsFittingChannels, Converter={StaticResource BoolToVis}}">
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="自动识别" Style="{StaticResource SmallGhostButton}" Command="{Binding SuggestFittingChannelsCommand}"
                                        IsEnabled="{Binding IsCollecting, Converter={StaticResource InverseBool}}" ToolTip="按通道名称（如 X1 / Y1 / Z1）重新匹配"/>
                                <TextBlock Text="拟合通道" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Grid IsEnabled="{Binding IsCollecting, Converter={StaticResource InverseBool}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Grid.Column="1" Text="X" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,2"/>
                                <TextBlock Grid.Column="2" Text="Y" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,2"/>
                                <TextBlock Grid.Column="3" Text="Z" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,2"/>
                                <TextBlock Grid.Row="1" Text="探头 1" VerticalAlignment="Center" Foreground="{DynamicResource Ink2Brush}"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="6,0,0,0" ItemsSource="{Binding FittingChannelOptions}" DisplayMemberPath="Label"
                                          SelectedValuePath="Index" SelectedValue="{Binding FitX1}" ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}"/>
                                <ComboBox Grid.Row="1" Grid.Column="2" Margin="6,0,0,0" ItemsSource="{Binding FittingChannelOptions}" DisplayMemberPath="Label"
                                          SelectedValuePath="Index" SelectedValue="{Binding FitY1}" ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}"/>
                                <ComboBox Grid.Row="1" Grid.Column="3" Margin="6,0,0,0" ItemsSource="{Binding FittingChannelOptions}" DisplayMemberPath="Label"
                                          SelectedValuePath="Index" SelectedValue="{Binding FitZ1}" ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}"/>
                            </Grid>
                            <Grid Margin="0,6,0,0" IsEnabled="{Binding IsCollecting, Converter={StaticResource InverseBool}}"
                                  Visibility="{Binding IsDualSensor, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="探头 2" VerticalAlignment="Center" Foreground="{DynamicResource Ink2Brush}"/>
                                <ComboBox Grid.Column="1" Margin="6,0,0,0" ItemsSource="{Binding FittingChannelOptions}" DisplayMemberPath="Label"
                                          SelectedValuePath="Index" SelectedValue="{Binding FitX2}" ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}"/>
                                <ComboBox Grid.Column="2" Margin="6,0,0,0" ItemsSource="{Binding FittingChannelOptions}" DisplayMemberPath="Label"
                                          SelectedValuePath="Index" SelectedValue="{Binding FitY2}" ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}"/>
                                <ComboBox Grid.Column="3" Margin="6,0,0,0" ItemsSource="{Binding FittingChannelOptions}" DisplayMemberPath="Label"
                                          SelectedValuePath="Index" SelectedValue="{Binding FitZ2}" ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}"/>
                            </Grid>
                            <TextBlock Text="{Binding FittingChannelHint}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFittingChannelValid}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- 实时数据 -->
                        <StackPanel Visibility="{Binding DataSource, Converter={StaticResource DockTabVisible}, ConverterParameter=Live}">
                            <Border Style="{StaticResource WarnCallout}" Margin="0,0,0,12"
                                    Visibility="{Binding IsDeviceConnected, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock TextWrapping="Wrap" Text="还没有连接设备。先在「连接」页连接，读数到达后才会进入校正采集。"/>
                            </Border>
                            <TextBlock Text="采集方式" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource SegmentGroup}" Margin="0,0,0,12" IsEnabled="{Binding IsCollecting, Converter={StaticResource InverseBool}}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentItem}" Content="连续采集"
                                                 IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBool}, ConverterParameter=Continuous}"/>
                                    <RadioButton Style="{StaticResource SegmentItem}" Content="手动 48 点"
                                                 IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBool}, ConverterParameter=Manual48}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Panel}" Padding="14">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                                   Text="每点取最近 10 条读数的均值" Visibility="{Binding IsManualMode, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Visibility="{Binding IsManualMode, Converter={StaticResource BoolToVis}}">
                                            <Run Text="已记录 "/><Run Text="{Binding CollectedSampleCount, Mode=OneWay}"/><Run Text=" / 48 点"/>
                                        </TextBlock>
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Visibility="{Binding IsContinuousMode, Converter={StaticResource BoolToVis}}">
                                            <Run Text="已采集 "/><Run Text="{Binding CollectedSampleCount, Mode=OneWay, StringFormat=N0}"/><Run Text=" 个样本"/>
                                        </TextBlock>
                                    </DockPanel>

                                    <!-- 48 点格子 -->
                                    <ItemsControl ItemsSource="{Binding ManualPointSlots}" Margin="-2,0,-2,10" Focusable="False"
                                                  Visibility="{Binding IsManualMode, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="12"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Cell" Height="16" CornerRadius="3" Margin="2" Background="{DynamicResource Panel3Brush}"/>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="on">
                                                        <Setter TargetName="Cell" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="next">
                                                        <Setter TargetName="Cell" Property="Background" Value="White"/>
                                                        <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter TargetName="Cell" Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding LiveValuesText}" FontFamily="{DynamicResource MonoFont}" FontSize="12.5" Margin="0,0,0,10"
                                               Foreground="{DynamicResource Ink2Brush}" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding IsCollecting, Converter={StaticResource BoolToVis}}"/>

                                    <!-- 未开始 -->
                                    <Button Content="开始采集" Style="{StaticResource PrimaryButton}" Height="36" Command="{Binding StartCollectingCommand}"
                                            Visibility="{Binding IsCollecting, Converter={StaticResource InverseBoolToVis}}"/>

                                    <!-- 采集中 -->
                                    <StackPanel Visibility="{Binding IsCollecting, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Visibility="{Binding IsManualMode, Converter={StaticResource BoolToVis}}">
                                            <!-- 与链路条按钮相同：缓冲满 10 条读数后才能记录 -->
                                            <Button Content="记录当前点" Style="{StaticResource PrimaryButton}" Height="40" FontSize="14"
                                                    IsEnabled="{Binding ManualState.HasEnoughBuffer}" Command="{Binding RecordCurrentPointCommand}"/>
                                            <DockPanel Margin="0,8,0,0">
                                                <Button DockPanel.Dock="Right" Content="结束采集" Style="{StaticResource SmallButton}" Command="{Binding StopCollectingCommand}"/>
                                                <Button Content="撤销上一点" Style="{StaticResource SmallButton}" Command="{Binding UndoLastPointCommand}" Margin="0,0,6,0"/>
                                                <Button Content="清空重来" Style="{StaticResource SmallButton}" Command="{Binding ClearManualPointsCommand}" HorizontalAlignment="Left"/>
                                            </DockPanel>
                                        </StackPanel>
                                        <Button Content="结束采集" Height="36" Command="{Binding StopCollectingCommand}"
                                                Visibility="{Binding IsContinuousMode, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                               Text="校正采集只读取读数，不影响会话保存。手动模式下也可以在任何页面点顶部链路条的「记录当前点」。"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 导入文件 -->
                        <StackPanel Visibility="{Binding DataSource, Converter={StaticResource DockTabVisible}, ConverterParameter=File}">
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="从 CSV / TXT 导入三轴数据（Bx, By, Bz；双三轴为六列）。第一行可以是列名，第一列可以是时间戳。"/>
                            <TextBlock Text="CSV 数值单位（必须选择）" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                            <ComboBox ItemsSource="{Binding FittingUnits}" SelectedItem="{Binding FittingUnit}" Width="120" HorizontalAlignment="Left"
                                      ToolTip="不会自动猜测或换算单位；实时采集和已保存会话使用记录的通道单位。"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="选择文件…" Style="{StaticResource PrimaryButton}" Command="{Binding ImportFromFileCommand}"/>
                                <Button Content="格式说明" Command="{Binding ShowCsvFormatHelpCommand}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 已保存会话 -->
                        <StackPanel Visibility="{Binding DataSource, Converter={StaticResource DockTabVisible}, ConverterParameter=Session}">
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="从数据库选一个已保存的会话，按上面的“拟合通道”取样本（拟合用校正前的原始值）。只读取，不修改会话。"/>
                            <Button Content="选择会话…" Style="{StaticResource PrimaryButton}" Command="{Binding LoadFromSessionCommand}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        </StackPanel>

                        <Border Style="{StaticResource Callout}" Margin="0,14,0,0">
                            <TextBlock Text="{Binding CollectionStatus}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <!-- 覆盖与质量 -->
                    <StackPanel Grid.Column="2">
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Right" FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold"
                                       Text="{Binding SphericityCoverage, StringFormat={}{0:F0}%}"/>
                            <TextBlock DockPanel.Dock="Right" Text="球面覆盖度" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="姿态覆盖" FontWeight="SemiBold"/>
                        </DockPanel>
                        <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding SphericityCoverage, Mode=OneWay}" Margin="0,0,0,12"
                                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource Panel3Brush}" BorderThickness="0"/>
                        <UniformGrid Columns="3" Height="190" Margin="0,0,-8,12">
                            <Border Style="{StaticResource Figure}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="XY 投影" FontSize="12" Foreground="{DynamicResource Ink2Brush}"/>
                                    <controls:ProjectionPlot Points="{Binding CollectedData}" AxisA="0" AxisB="1"
                                                             PointBrush="{DynamicResource AccentBrush}" GuideBrush="{DynamicResource LineBrush}"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Figure}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="XZ 投影" FontSize="12" Foreground="{DynamicResource Ink2Brush}"/>
                                    <controls:ProjectionPlot Points="{Binding CollectedData}" AxisA="0" AxisB="2"
                                                             PointBrush="{DynamicResource AccentBrush}" GuideBrush="{DynamicResource LineBrush}"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Figure}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="YZ 投影" FontSize="12" Foreground="{DynamicResource Ink2Brush}"/>
                                    <controls:ProjectionPlot Points="{Binding CollectedData}" AxisA="1" AxisB="2"
                                                             PointBrush="{DynamicResource AccentBrush}" GuideBrush="{DynamicResource LineBrush}"/>
                                </DockPanel>
                            </Border>
                        </UniformGrid>
                        <UniformGrid Columns="4" Margin="0,0,-8,4">
                            <Border Style="{StaticResource StatTile}">
                                <StackPanel>
                                    <TextBlock Text="总场均值" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Style="{StaticResource StatValue}"
                                               Text="{Binding DataValidation.MeanTotalField, StringFormat={}{0:G6}, FallbackValue=—, TargetNullValue=—}"/>
                                    <TextBlock Text="{Binding CollectedUnit}" Style="{StaticResource StatLabel}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatTile}">
                                <StackPanel>
                                    <TextBlock Text="总场标准差" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Style="{StaticResource StatValue}"
                                               Text="{Binding DataValidation.TotalFieldStdDev, StringFormat={}{0:G6}, FallbackValue=—, TargetNullValue=—}"/>
                                    <TextBlock Text="{Binding CollectedUnit}" Style="{StaticResource StatLabel}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatTile}">
                                <StackPanel>
                                    <TextBlock Text="变异系数" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Style="{StaticResource StatValue}"
                                               Text="{Binding DataValidation.TotalFieldCoeffOfVariation, StringFormat={}{0:P3}, FallbackValue=—, TargetNullValue=—}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatTile}">
                                <StackPanel>
                                    <TextBlock Text="突变点" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Style="{StaticResource StatValue}"
                                               Text="{Binding DataValidation.RejectedCount, FallbackValue=—, TargetNullValue=—}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Style="{StaticResource WarnCallout}" Margin="0,0,0,10"
                                Visibility="{Binding HasValidationWarnings, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="数据质量提示" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding ValidationStatusText}" TextWrapping="Wrap"/>
                                <TextBlock Text="仅为建议，不阻止计算。" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Hint}" Text="覆盖度越高，计算越稳定；不足时仍可计算，结果页会给出质量评级。投影只用于预览，统计约每 50 个样本（手动模式每 6 点）更新一次。"/>
                    </StackPanel>
                </Grid>

                <!-- ==================== 第 3 步：计算与结果 ==================== -->
                <Grid Visibility="{Binding CurrentStep, Converter={StaticResource DockTabVisible}, ConverterParameter=3}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*" MinWidth="420"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Left" Content="执行计算" Style="{StaticResource PrimaryButton}" MinWidth="96"
                                    Command="{Binding RunCalculationCommand}" IsEnabled="{Binding IsCalculating, Converter={StaticResource InverseBool}}"/>
                            <TextBlock Text="{Binding CalculationStatus}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </DockPanel>
                        <ProgressBar Height="3" IsIndeterminate="{Binding IsCalculating}" Foreground="{DynamicResource AccentBrush}" BorderThickness="0"
                                     Visibility="{Binding IsCalculating, Converter={StaticResource BoolToVis}}"/>

                        <!-- 双三轴：第一组 / 第二组 -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding IsDualSensor, Converter={StaticResource BoolToVis}}">
                            <RadioButton Style="{StaticResource TabRadio}" Content="第一组" Height="36"
                                         IsChecked="{Binding SelectedResultGroup, Converter={StaticResource ValueEquals}, ConverterParameter=0}"/>
                            <RadioButton Style="{StaticResource TabRadio}" Content="第二组" Height="36"
                                         IsChecked="{Binding SelectedResultGroup, Converter={StaticResource ValueEquals}, ConverterParameter=1}"/>
                        </StackPanel>

                        <StackPanel DataContext="{Binding DisplayedResult}" Visibility="{Binding Converter={StaticResource NullToCollapsed}}" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="质量评级" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Border Style="{StaticResource RatingBadge}">
                                    <TextBlock Text="{Binding Rating}" FontSize="13" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding RatingHint}" Style="{StaticResource Hint}" Margin="0,-8,0,14"/>

                            <TextBlock Text="补偿矩阵 M" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource MatrixBox}" Margin="0,0,0,12">
                                <ItemsControl ItemsSource="{Binding Matrix}" ItemTemplate="{StaticResource MatrixCell}" ItemsPanel="{StaticResource ThreeColumns}" Focusable="False"/>
                            </Border>
                            <TextBlock Style="{StaticResource FieldLabel}"><Run Text="偏移 O（"/><Run Text="{Binding Unit, Mode=OneWay}"/><Run Text="）"/></TextBlock>
                            <Border Style="{StaticResource MatrixBox}" Margin="0,0,0,14">
                                <ItemsControl ItemsSource="{Binding Offset}" ItemTemplate="{StaticResource MatrixCell}" ItemsPanel="{StaticResource ThreeColumns}" Focusable="False"/>
                            </Border>

                            <UniformGrid Columns="2" Margin="0,0,-8,4">
                                <Border Style="{StaticResource StatTile}">
                                    <StackPanel>
                                        <TextBlock Text="残差均值" Style="{StaticResource StatLabel}"/>
                                        <TextBlock Style="{StaticResource StatValue}"><Run Text="{Binding Quality.ResidualMean, Mode=OneWay, StringFormat={}{0:G6}}"/><Run Text=" "/><Run Text="{Binding Unit, Mode=OneWay}"/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTile}">
                                    <StackPanel>
                                        <TextBlock Text="残差标准差" Style="{StaticResource StatLabel}"/>
                                        <TextBlock Style="{StaticResource StatValue}"><Run Text="{Binding Quality.ResidualStd, Mode=OneWay, StringFormat={}{0:G6}}"/><Run Text=" "/><Run Text="{Binding Unit, Mode=OneWay}"/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTile}">
                                    <StackPanel>
                                        <TextBlock Text="最大残差" Style="{StaticResource StatLabel}"/>
                                        <TextBlock Style="{StaticResource StatValue}"><Run Text="{Binding Quality.MaxResidual, Mode=OneWay, StringFormat={}{0:G6}}"/><Run Text=" "/><Run Text="{Binding Unit, Mode=OneWay}"/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTile}">
                                    <StackPanel>
                                        <TextBlock Text="样本数 · 覆盖度" Style="{StaticResource StatLabel}"/>
                                        <TextBlock Style="{StaticResource StatValue}">
                                            <Run Text="{Binding Quality.SampleCount, Mode=OneWay, StringFormat=N0}"/><Run Text=" · "/><Run Text="{Binding Quality.SphericityCoverage, Mode=OneWay, StringFormat={}{0:P0}}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource Hint}" Text="校正公式：B改正 = M ×（B原始 − O）。残差 = 校正后总场 − 校正后总场均值。"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                                   Visibility="{Binding DisplayedResult, Converter={StaticResource EmptyToVisible}}"
                                   Text="这一组还没有结果。点「执行计算」；双三轴的第二组需要至少 3 个样本。"/>
                    </StackPanel>

                    <views:CalibrationVisualizationControl Grid.Column="2" Height="480" VerticalAlignment="Top"
                                                           Unit="{Binding DisplayedResult.Unit}"
                                                           RawData="{Binding DisplayedResult.RawData}"
                                                           CorrectedData="{Binding DisplayedResult.CorrectedData}"
                                                           Visibility="{Binding DisplayedResult, Converter={StaticResource NullToCollapsed}}"/>
                </Grid>

                <!-- ==================== 第 4 步：保存配置 ==================== -->
                <StackPanel Width="440" HorizontalAlignment="Left"
                            Visibility="{Binding CurrentStep, Converter={StaticResource DockTabVisible}, ConverterParameter=4}">
                    <TextBlock Text="配置名称" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                    <TextBlock Text="备注（可选）" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding ProfileNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="76" VerticalContentAlignment="Top" Padding="6,4" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12" Visibility="{Binding IsDualSensor, Converter={StaticResource BoolToVis}}"
                               Text="双三轴会保存两条配置，第二组的名称后加“_第二组”。"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="保存配置" Style="{StaticResource PrimaryButton}" MinWidth="96" Command="{Binding SaveProfileCommand}"/>
                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0" Text="保存后可在「配置库」中查看、导出或删除。"/>
                    </StackPanel>
                    <Border Style="{StaticResource Callout}" Margin="0,14,0,0" Visibility="{Binding SaveStatus, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding SaveStatus}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
