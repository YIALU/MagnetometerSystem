<UserControl x:Class="MagnetometerSystem.App.Views.DeviceCommandView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:MagnetometerSystem.Core.Models;assembly=MagnetometerSystem.Core"
             xmlns:vm="clr-namespace:MagnetometerSystem.App.ViewModels"
             Background="{DynamicResource EnclosureBrush}">
    <!-- 命令页：命令列表 | 参数、预览与发送结果 | 通信日志。DataContext = DeviceCommandViewModel。 -->
    <UserControl.Resources>
        <Style x:Key="StepDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Margin" Value="0,4,10,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Fill" Value="{DynamicResource LineBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*" MinWidth="360"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 命令列表 ===== -->
        <Border Style="{StaticResource Panel}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                    <DockPanel VerticalAlignment="Center">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="导入" Style="{StaticResource SmallGhostButton}" Command="{Binding ImportCatalogCommand}" ToolTip="导入命令目录（JSON）"/>
                            <Button Content="导出" Style="{StaticResource SmallGhostButton}" Command="{Binding ExportCatalogCommand}" ToolTip="导出命令目录（JSON）"/>
                        </StackPanel>
                        <TextBlock Text="命令" Style="{StaticResource PanelTitle}"/>
                    </DockPanel>
                </Border>
                <StackPanel DockPanel.Dock="Top" Margin="12,10,12,8">
                    <TextBlock Text="命令组" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Groups}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedGroup}" Margin="0,0,0,6"/>
                    <WrapPanel>
                        <Button Content="新建组" Style="{StaticResource SmallButton}" Command="{Binding AddGroupCommand}" Margin="0,0,6,0"/>
                        <Button Content="改名" Style="{StaticResource SmallButton}" Command="{Binding RenameGroupCommand}" CommandParameter="{Binding SelectedGroup}"
                                IsEnabled="{Binding CanEditSelectedGroup}" Margin="0,0,6,0"/>
                        <Button Content="删除组" Style="{StaticResource SmallGhostButton}" Foreground="{DynamicResource ErrBrush}"
                                Command="{Binding DeleteGroupCommand}" CommandParameter="{Binding SelectedGroup}" IsEnabled="{Binding CanEditSelectedGroup}"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="协议内置命令随协议切换，不能修改；可新建自己的命令组。"
                               Visibility="{Binding SelectedGroupIsBuiltIn, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="12,8,12,12" IsEnabled="{Binding CanEditSelectedGroup}">
                    <Button Content="新建命令" Style="{StaticResource SmallButton}" Command="{Binding AddCommandCommand}" Margin="0,0,6,0"/>
                    <Button Content="编辑" Style="{StaticResource SmallButton}" Command="{Binding EditCommandCommand}" CommandParameter="{Binding SelectedCommand}" Margin="0,0,6,0"/>
                    <Button Content="删除" Style="{StaticResource SmallGhostButton}" Foreground="{DynamicResource ErrBrush}"
                            Command="{Binding DeleteCommandCommand}" CommandParameter="{Binding SelectedCommand}"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding CurrentCommands}" SelectedItem="{Binding SelectedCommand}" ItemContainerStyle="{StaticResource FlatListItem}"
                         BorderThickness="0,1,0,1" BorderBrush="{DynamicResource Line2Brush}" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:DeviceCommand}">
                            <StackPanel Margin="14,8,10,8">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                           Visibility="{Binding Description, Converter={StaticResource NullToCollapsed}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== 参数、预览、发送 ===== -->
        <Border Grid.Column="2" Style="{StaticResource Panel}">
            <Grid>
                <TextBlock Style="{StaticResource Hint}" Text="在左侧选择一条命令。" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding SelectedCommand, Converter={StaticResource EmptyToVisible}}"/>
                <DockPanel Visibility="{Binding SelectedCommand, Converter={StaticResource NullToCollapsed}}">
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Padding="16,8">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedCommand.Name}" Style="{StaticResource PanelTitle}" FontSize="15"/>
                            <TextBlock Text="{Binding SelectedCommand.Description}" Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Visibility="{Binding SelectedCommand.Description, Converter={StaticResource NullToCollapsed}}"/>
                        </StackPanel>
                    </Border>

                    <!-- 发送与结果 -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,1,0,0" Padding="16,12,16,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="发送" Style="{StaticResource PrimaryButton}" MinWidth="88"
                                        Command="{Binding SendSelectedCommandCommand}" IsEnabled="{Binding IsConnected}"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="应答超时" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Ink2Brush}"/>
                                    <TextBox Width="70" Style="{StaticResource MonoTextBox}" TextAlignment="Right" Text="{Binding ResponseTimeoutMs, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Text="ms" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </DockPanel>
                            <!-- 未连接提示单独一行，不与发送按钮挤在一起 -->
                            <TextBlock Text="未连接设备，不能发送。先在「连接」页连接。" TextWrapping="Wrap" Foreground="{DynamicResource WarnBrush}" FontSize="12"
                                       Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVis}}"/>
                            <Border Height="8"/>
                            <TextBlock Text="发送结果" Style="{StaticResource SectionTitle}"/>
                            <!-- 三级：本地写出 ≠ 收到应答 ≠ 设备执行成功 -->
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Ellipse Style="{StaticResource StepDot}" Fill="{DynamicResource AccentBrush}"/>
                                <TextBlock Grid.Column="1" Text="本地写出" Foreground="{DynamicResource Ink2Brush}" Margin="0,0,0,8"/>
                                <TextBlock Grid.Column="2" Text="{Binding WriteStatus}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Ellipse Grid.Row="1" Style="{StaticResource StepDot}" Fill="{DynamicResource AccentBrush}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="设备应答" Foreground="{DynamicResource Ink2Brush}" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ResponseStatus}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Ellipse Grid.Row="2" Style="{StaticResource StepDot}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="执行结果" Foreground="{DynamicResource Ink2Brush}"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                                           Text="软件无法直接确认。请核对应答内容，或观察顶部「实测」频率、曲线等数据变化。"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,12,16,12">
                            <TextBlock Text="模板" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding SelectedCommand.Template}" FontFamily="{DynamicResource MonoFont}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                            <TextBlock Text="参数" Style="{StaticResource SectionTitle}"
                                       Visibility="{Binding CurrentParameters.Count, Converter={StaticResource NonZeroToVisibility}}"/>
                            <ItemsControl ItemsSource="{Binding CurrentParameters}" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CommandParameterBinding}">
                                        <StackPanel Margin="0,0,0,10">
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock DockPanel.Dock="Right" FontSize="11.5" Foreground="{DynamicResource MutedBrush}">
                                                    <Run Text="范围 "/><Run Text="{Binding Definition.Min, Mode=OneWay, TargetNullValue='—', FallbackValue='—'}"/><Run Text=" ~ "/><Run Text="{Binding Definition.Max, Mode=OneWay, TargetNullValue='—', FallbackValue='—'}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Definition.Name}" Foreground="{DynamicResource Ink2Brush}" FontSize="12"/>
                                            </DockPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Definition.Unit}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource MutedBrush}" MinWidth="24"/>
                                                <Grid>
                                                    <TextBox Style="{StaticResource MonoTextBox}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility="{Binding IsFreeText, Converter={StaticResource BoolToVis}}"/>
                                                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}"
                                                              Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                            </DockPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="将要发送" Style="{StaticResource SectionTitle}"/>
                            <Border Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource Line2Brush}" BorderThickness="1" CornerRadius="4" Padding="12,10">
                                <TextBlock Text="{Binding PreviewText}" FontFamily="{DynamicResource MonoFont}" TextWrapping="Wrap" LineHeight="20"/>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="预览按当前参数生成；发送的字节与预览一致。"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ===== 通信日志 ===== -->
        <Border Grid.Column="4" Style="{StaticResource Panel}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                    <DockPanel VerticalAlignment="Center">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <CheckBox Content="暂停滚动" IsChecked="{Binding PauseAutoScroll}" Margin="0,0,10,0"/>
                            <Button Content="复制" Style="{StaticResource SmallGhostButton}" Command="{Binding CopyTrafficCommand}" ToolTip="复制全部记录（制表符分隔）"/>
                            <Button Content="清空" Style="{StaticResource SmallGhostButton}" Command="{Binding ClearLogCommand}"/>
                        </StackPanel>
                        <TextBlock Text="通信日志" Style="{StaticResource PanelTitle}"/>
                    </DockPanel>
                </Border>
                <!-- 自由发送 -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,1,0,0" Padding="12,10,12,12">
                    <StackPanel>
                        <TextBlock Text="自由发送" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource MonoTextBox}" Text="{Binding FreeCommandText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                                 ToolTip="ASCII 命令；勾选 HEX 后输入空格分隔的字节">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SendFreeCommandCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="发送" Style="{StaticResource PrimaryButton}" Command="{Binding SendFreeCommandCommand}" IsEnabled="{Binding IsConnected}"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding FreeLineEndings}" SelectedItem="{Binding FreeLineEnding}" Width="84" Margin="0,0,10,0" ToolTip="行尾；None 表示不追加"/>
                                <CheckBox Content="HEX" IsChecked="{Binding FreeIsHexMode}"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Grid>
                    <ListBox x:Name="TrafficList" ItemsSource="{Binding TrafficEntries}" ItemTemplate="{StaticResource TrafficRowTemplate}"
                             BorderThickness="0" Background="Transparent" Padding="8,4" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"/>
                    <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" TextAlignment="Center"
                               Text="发送的命令、收到的数据和应答判定会记录在这里（最近 500 条）。"
                               Visibility="{Binding TrafficEntries.Count, Converter={StaticResource ZeroToVisible}}"/>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
