<UserControl x:Class="MagnetometerSystem.App.Views.AcquisitionWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MagnetometerSystem.App.Views"
             xmlns:vm="clr-namespace:MagnetometerSystem.App.ViewModels"
             Background="{DynamicResource EnclosureBrush}">
    <!-- 采集工作台：曲线 + 右侧任务面板 + 底部停靠区。折叠任何区域都只影响显示，不影响采集与保存。 -->
    <Grid x:Name="Root" Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420"/>
            <ColumnDefinition x:Name="SideGapColumn" Width="12"/>
            <ColumnDefinition x:Name="SideColumn" Width="350" MinWidth="0"/>
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="220"/>
                <RowDefinition x:Name="DockGapRow" Height="10"/>
                <RowDefinition x:Name="DockRow" Height="230"/>
            </Grid.RowDefinitions>

            <!-- 曲线 -->
            <Border Style="{StaticResource Panel}" ClipToBounds="True">
                <Grid>
                    <views:RealtimeChartView DataContext="{Binding RealtimeChartVM}"/>
                    <!-- 未连接且曲线没有数据时的空状态；断开后保留刚采到的曲线 -->
                    <Border x:Name="EmptyState" Background="{DynamicResource PanelBrush}" Margin="1,46,1,1"
                            Visibility="{Binding ShowWorkspaceEmptyState, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                            <TextBlock Text="还没有连接设备" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" FontSize="13" LineHeight="21">
                                <Run Text="当前端口 "/><Run Text="{Binding PortSummary, Mode=OneWay}"/><Run Text="，协议「"/><Run Text="{Binding ProtocolInfo, Mode=OneWay}"/><Run Text="」。点「连接并开始保存」后会先创建新会话，再开始接收；解析出的读数自动保存并在这里绘制。"/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                <Button Content="连接并开始保存" Style="{StaticResource PrimaryButton}" Command="{Binding ConnectionVM.ConnectCommand}" Margin="0,0,8,0"/>
                                <Button Content="检查连接参数" Command="{Binding NavigateToConnectionCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter x:Name="DockSplitter" Grid.Row="1" Height="10" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS" Background="Transparent"/>

            <!-- 底部停靠区：收发 / 原始报文 / 事件 -->
            <Border Grid.Row="2" Style="{StaticResource Panel}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line2Brush}" Padding="14,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WorkspaceLayout.DockOpen}" Value="False">
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Visibility="{Binding WorkspaceLayout.DockOpen, Converter={StaticResource BoolToVis}}">
                                    <!-- 收发 -->
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding WorkspaceLayout.DockTab, Converter={StaticResource DockTabVisible}, ConverterParameter=0}">
                                        <CheckBox Content="暂停滚动" IsChecked="{Binding DeviceCommandVM.PauseAutoScroll}" Margin="0,0,12,0"/>
                                        <Button Content="清空" Style="{StaticResource SmallGhostButton}" Command="{Binding DeviceCommandVM.ClearLogCommand}"/>
                                    </StackPanel>
                                    <!-- 原始报文 -->
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding WorkspaceLayout.DockTab, Converter={StaticResource DockTabVisible}, ConverterParameter=1}">
                                        <Border Style="{StaticResource SegmentGroup}" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Style="{StaticResource SegmentItem}" Content="解析记录" MinHeight="22" Padding="8,0"
                                                             IsChecked="{Binding ConnectionVM.ShowRawBlocks, Converter={StaticResource InverseBool}}"/>
                                                <RadioButton Style="{StaticResource SegmentItem}" Content="数据块" MinHeight="22" Padding="8,0"
                                                             IsChecked="{Binding ConnectionVM.ShowRawBlocks}"/>
                                            </StackPanel>
                                        </Border>
                                        <CheckBox Content="HEX 显示" IsChecked="{Binding ConnectionVM.ShowHex}" Margin="0,0,12,0"
                                                  ToolTip="影响之后收到的数据块如何显示，不影响解析"
                                                  Visibility="{Binding ConnectionVM.ShowRawBlocks, Converter={StaticResource BoolToVis}}"/>
                                        <Button Content="清空" Style="{StaticResource SmallGhostButton}" Command="{Binding ConnectionVM.ClearRawDataCommand}"/>
                                    </StackPanel>
                                    <!-- 事件 -->
                                    <Button Content="清空" Style="{StaticResource SmallGhostButton}" Command="{Binding ClearEventsCommand}"
                                            Visibility="{Binding WorkspaceLayout.DockTab, Converter={StaticResource DockTabVisible}, ConverterParameter=2}"/>
                                </StackPanel>
                                <Button Command="{Binding WorkspaceLayout.ToggleDockCommand}" Margin="6,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SmallGhostButton}">
                                            <Setter Property="Content" Value="收起"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WorkspaceLayout.DockOpen}" Value="False">
                                                    <Setter Property="Content" Value="展开"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource TabRadio}" Content="收发" Height="38" Click="DockTab_Click"
                                             IsChecked="{Binding WorkspaceLayout.DockTab, Converter={StaticResource ValueEquals}, ConverterParameter=0}"/>
                                <RadioButton Style="{StaticResource TabRadio}" Height="38" Click="DockTab_Click"
                                             IsChecked="{Binding WorkspaceLayout.DockTab, Converter={StaticResource ValueEquals}, ConverterParameter=1}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="原始报文"/>
                                        <Border Style="{StaticResource WarnBadge}" Margin="6,0,0,0" Padding="5,0"
                                                Visibility="{Binding ConnectionVM.ParseErrorCount, Converter={StaticResource NonZeroToVisibility}}">
                                            <TextBlock FontSize="11" FontWeight="Normal"><Run Text="{Binding ConnectionVM.ParseErrorCount, Mode=OneWay, StringFormat=N0}"/><Run Text=" 异常"/></TextBlock>
                                        </Border>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource TabRadio}" Content="事件" Height="38" Click="DockTab_Click"
                                             IsChecked="{Binding WorkspaceLayout.DockTab, Converter={StaticResource ValueEquals}, ConverterParameter=2}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid Visibility="{Binding WorkspaceLayout.DockOpen, Converter={StaticResource BoolToVis}}">
                        <!-- 收发 -->
                        <DockPanel DataContext="{Binding DeviceCommandVM}" Margin="12,8,12,10"
                                   Visibility="{Binding DataContext.WorkspaceLayout.DockTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource DockTabVisible}, ConverterParameter=0}">
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                       Text="「已写出」只表示本机发送完成；设备是否执行，看应答或数据变化。完整命令与参数在「命令」页。"/>
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Content="发送" Style="{StaticResource PrimaryButton}" Command="{Binding SendFreeCommandCommand}" Margin="8,0,0,0" MinWidth="64"/>
                                <CheckBox DockPanel.Dock="Right" Content="HEX" IsChecked="{Binding FreeIsHexMode}" Margin="10,0,0,0"/>
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding FreeLineEndings}" SelectedItem="{Binding FreeLineEnding}" Width="84" Margin="8,0,0,0"
                                          ToolTip="发送时追加的行尾；None 表示不追加"/>
                                <TextBox Style="{StaticResource MonoTextBox}" Text="{Binding FreeCommandText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="输入 ASCII 命令，或勾选 HEX 后输入空格分隔的字节">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SendFreeCommandCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource Hint}"><Run Text="写出："/><Run Text="{Binding WriteStatus, Mode=OneWay}"/><Run Text="　　应答："/><Run Text="{Binding ResponseStatus, Mode=OneWay}"/></TextBlock>
                            </DockPanel>
                            <Grid>
                                <ListBox x:Name="TrafficLog" ItemsSource="{Binding TrafficEntries}" ItemTemplate="{StaticResource TrafficRowTemplate}"
                                         HorizontalContentAlignment="Stretch" Padding="4,2"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"/>
                                <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="发送的命令、收到的数据和应答判定会记录在这里（最近 500 条）。"
                                           Visibility="{Binding TrafficEntries.Count, Converter={StaticResource ZeroToVisible}}"/>
                            </Grid>
                        </DockPanel>

                        <!-- 原始报文 -->
                        <DockPanel Margin="12,8,12,10"
                                   Visibility="{Binding WorkspaceLayout.DockTab, Converter={StaticResource DockTabVisible}, ConverterParameter=1}">
                            <Border DockPanel.Dock="Top" Style="{StaticResource WarnCallout}" Margin="0,0,0,8" Padding="10,6"
                                    Visibility="{Binding ConnectionVM.LastError, Converter={StaticResource NullToCollapsed}}">
                                <TextBlock TextWrapping="Wrap"><Run Text="最近的解析 / 连接提示："/><Run Text="{Binding ConnectionVM.LastError, Mode=OneWay}"/></TextBlock>
                            </Border>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                       Visibility="{Binding ConnectionVM.ShowRawBlocks, Converter={StaticResource BoolToVis}}">
                                <Run Text="按到达顺序显示收到的数据块（最近 200 块）。一块不等于一帧：分包、粘包由解析器按协议拼接。解析异常 "/><Run Text="{Binding ConnectionVM.ParseErrorCount, Mode=OneWay, StringFormat=N0}"/><Run Text=" 次。"/>
                            </TextBlock>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                       Visibility="{Binding ConnectionVM.ShowRawBlocks, Converter={StaticResource InverseBoolToVis}}">
                                <Run Text="逐帧解析结果（最近 200 行）：连续通过的帧合并为一行；✗ 是被拒绝的候选帧和原因，⚠ 是丢弃的字节（噪声、帧头前残留、表头 / 注释 / 设备响应）。解析异常 "/><Run Text="{Binding ConnectionVM.ParseErrorCount, Mode=OneWay, StringFormat=N0}"/><Run Text=" 次。"/>
                            </TextBlock>
                            <Grid>
                                <ListBox x:Name="RawList" ItemsSource="{Binding ConnectionVM.RawDataLines}" FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True"
                                         Visibility="{Binding ConnectionVM.ShowRawBlocks, Converter={StaticResource BoolToVis}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" TextWrapping="NoWrap"/></DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Grid Visibility="{Binding ConnectionVM.ShowRawBlocks, Converter={StaticResource InverseBoolToVis}}">
                                <ListBox x:Name="RecordList" ItemsSource="{Binding ConnectionVM.ParseRecords}" FontSize="12"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ParseRecordRow}">
                                            <DockPanel Margin="0,1">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding TimeText}" Width="218" TextTrimming="CharacterEllipsis" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource MutedBrush}"/>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding SizeText}" Width="140" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource MutedBrush}"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Margin="12,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level}" Value="err"><Setter Property="Foreground" Value="{DynamicResource ErrBrush}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="warn"><Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Record.Preview}" FontFamily="{DynamicResource MonoFont}" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="连接后，这里逐帧显示解析结果：通过、被拒绝的原因、重新同步丢弃的字节。"
                                           Visibility="{Binding ConnectionVM.ParseRecords.Count, Converter={StaticResource ZeroToVisible}}"/>
                                </Grid>
                            </Grid>
                        </DockPanel>

                        <!-- 事件 -->
                        <Grid Margin="12,8,12,10"
                              Visibility="{Binding WorkspaceLayout.DockTab, Converter={StaticResource DockTabVisible}, ConverterParameter=2}">
                            <ListBox ItemsSource="{Binding Events}" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource FlatListItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:WorkspaceEvent}">
                                        <DockPanel Margin="4,5">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Time, StringFormat=HH:mm:ss.fff}" FontFamily="{DynamicResource MonoFont}"
                                                       Foreground="{DynamicResource MutedBrush}" Width="96" FontSize="12"/>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ErrBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding IsWarning}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Style="{StaticResource Hint}" Text="连接、首帧、会话创建与结束、保存失败等事件会记录在这里。" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Events.Count, Converter={StaticResource ZeroToVisible}}"/>
                        </Grid>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 右侧任务面板 -->
        <Border Grid.Column="2" x:Name="SidePanel" Style="{StaticResource Panel}">
            <views:WorkspaceSidePanel/>
        </Border>
    </Grid>
</UserControl>
