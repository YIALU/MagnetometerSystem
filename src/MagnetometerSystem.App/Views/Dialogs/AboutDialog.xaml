<Window x:Class="MagnetometerSystem.App.Views.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于"
        Width="560" Height="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="磁力仪数据采集与分析系统"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" x:Name="VersionText"
                   FontFamily="Consolas" FontSize="13" Foreground="#444"
                   Margin="0,0,0,12"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="版本号:" Foreground="#666" Margin="0,2"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="VersionNumberText" FontFamily="Consolas" Margin="0,2"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="版本标识:" Foreground="#666" Margin="0,2"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CommitText" FontFamily="Consolas" Margin="0,2"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="构建时间:" Foreground="#666" Margin="0,2"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="BuildTimeText" FontFamily="Consolas" Margin="0,2"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="安装方式:" Foreground="#666" Margin="0,2"/>
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="PackageKindText" FontFamily="Consolas" Margin="0,2"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="运行环境:" Foreground="#666" Margin="0,2"/>
            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="RuntimeText" FontFamily="Consolas" Margin="0,2"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Gitee:" Foreground="#666" Margin="0,2"/>
            <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,2" TextTrimming="CharacterEllipsis">
                <Hyperlink x:Name="HomepageLink" RequestNavigate="Hyperlink_RequestNavigate"
                           ToolTip="在浏览器中打开">
                    <Run x:Name="HomepageText"/>
                </Hyperlink>
            </TextBlock>
            <TextBlock Grid.Row="6" Grid.Column="0" Text="GitHub:" Foreground="#666" Margin="0,2"/>
            <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,2" TextTrimming="CharacterEllipsis">
                <Hyperlink x:Name="GitHubLink" RequestNavigate="Hyperlink_RequestNavigate" ToolTip="在浏览器中打开">
                    <Run x:Name="GitHubText"/>
                </Hyperlink>
            </TextBlock>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="UpdateStatusText"
                   FontSize="12" Foreground="#666" Margin="0,10,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="反馈与建议" Padding="10,4" Margin="0,0,8,0" Click="Feedback_Click"/>
            <Button x:Name="CheckUpdateButton" Content="检查更新" Padding="10,4" Margin="0,0,8,0"
                    Click="CheckUpdate_Click"/>
            <Button Content="复制版本信息" Padding="10,4" Margin="0,0,8,0" Click="Copy_Click"/>
            <Button Content="关闭" Width="80" IsDefault="True" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
