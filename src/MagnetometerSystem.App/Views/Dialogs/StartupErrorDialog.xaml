<Window x:Class="MagnetometerSystem.App.Views.Dialogs.StartupErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="无法启动" Width="560" Height="380" MinWidth="420" MinHeight="280"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="软件未能启动。请检查磁盘空间和数据目录是否可读写，然后重新启动。若仍无法启动，可复制下方详细原因发给维护者。"
                   TextWrapping="Wrap" Margin="0,0,0,16"/>
        <Expander x:Name="DetailsExpander" Grid.Row="1" Header="查看详细原因" IsExpanded="False">
            <TextBox x:Name="DetailsText" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8,0,0"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
        </Expander>
        <Button Grid.Row="2" Content="关闭" Width="90" HorizontalAlignment="Right" Margin="0,16,0,0"
                IsDefault="True" IsCancel="True" Click="Close_Click"/>
    </Grid>
</Window>
