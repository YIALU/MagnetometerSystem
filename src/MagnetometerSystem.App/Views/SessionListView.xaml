<UserControl x:Class="MagnetometerSystem.App.Views.SessionListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:MagnetometerSystem.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:EqualsConverter x:Key="EqualsConverter"/>
    </UserControl.Resources>

    <DockPanel Margin="10">
        <!-- 顶部: 筛选栏 -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Width="200" Margin="0,0,10,0" VerticalContentAlignment="Center"
                     ToolTip="搜索会话名称或备注"/>
            <TextBlock Text="从:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker SelectedDate="{Binding FilterStartDate}" Width="130" Margin="0,0,10,0"/>
            <TextBlock Text="到:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker SelectedDate="{Binding FilterEndDate}" Width="130" Margin="0,0,10,0"/>
            <Button Content="刷新" Command="{Binding RefreshSessionsCommand}" Padding="10,3"/>
        </WrapPanel>

        <Border DockPanel.Dock="Top" Background="#EFF6FF" Padding="10,6" Margin="0,0,0,8" CornerRadius="4">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="{Binding StorageStatus}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding SavedReadingCount, StringFormat=已落库 {0:N0} 条}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding PendingReadingCount, StringFormat=待保存 {0:N0} 条}" Margin="0,0,16,0"/>
                    <Button Content="重试保存" Command="{Binding RetryStorageCommand}" Padding="8,2"/>
                </WrapPanel>
                <TextBlock Text="{Binding StorageError}" Foreground="#B91C1C" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 状态: 当前采集指示 -->
        <Border DockPanel.Dock="Top"
                Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}"
                Background="#FFCDD2" BorderBrush="#E53935" BorderThickness="3,1,1,1"
                Padding="10,6" Margin="0,0,0,10" CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Fill="#E53935" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock FontWeight="Bold" Foreground="#B71C1C">
                    <Run Text="录制中  "/>
                    <Run Text="会话 ID: "/>
                    <Run Text="{Binding ActiveSessionId, Mode=OneWay}"/>
                    <Run Text="  （即下表橙色行）"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- 主体: DataGrid -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0"
                  ItemsSource="{Binding SessionsView}"
                  SelectedItem="{Binding SelectedSession}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F9F9F9"
                  HeadersVisibility="Column"
                  CanUserResizeColumns="True">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource EqualsConverter}">
                                    <Binding Path="Id"/>
                                    <Binding Path="DataContext.ActiveSessionId" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter Property="Background" Value="#FFF3E0"/>
                            <Setter Property="Foreground" Value="#E65100"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="BorderBrush" Value="#E65100"/>
                            <Setter Property="BorderThickness" Value="4,0,0,0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="会话名称" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="开始时间" Binding="{Binding StartedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160"/>
                <DataGridTextColumn Header="结束时间" Binding="{Binding EndedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160"/>
                <DataGridTextColumn Header="通道数" Binding="{Binding ChannelCount}" Width="70"/>
                <DataGridTextColumn Header="标称采样率" Binding="{Binding SampleRate, StringFormat={}{0} Hz}" Width="90"/>
                <DataGridTemplateColumn Header="数据点数" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding TotalReadings, StringFormat=N0}"/>
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource EqualsConverter}">
                                                        <Binding Path="Id"/>
                                                        <Binding Path="DataContext.ActiveSessionId" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Text" Value="{Binding DataContext.ActiveSessionReadingCount, RelativeSource={RelativeSource AncestorType=DataGrid}, StringFormat={}{0:N0} (录制中)}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#C62828"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="备注" Binding="{Binding Notes}" Width="*"/>
            </DataGrid.Columns>

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="重命名"
                              Command="{Binding RenameSessionCommand}"
                              CommandParameter="{Binding SelectedSession}"/>
                    <MenuItem Header="编辑备注"
                              Command="{Binding EditNotesCommand}"
                              CommandParameter="{Binding SelectedSession}"/>
                    <Separator/>
                    <MenuItem Header="导出 CSV"
                              Command="{Binding ExportSessionCommand}"
                              CommandParameter="{Binding SelectedSession}"/>
                    <MenuItem Header="历史回放"
                              Command="{Binding PlaybackSessionCommand}"
                              CommandParameter="{Binding SelectedSession}"/>
                    <Separator/>
                    <MenuItem Header="删除"
                              Command="{Binding DeleteSessionCommand}"
                              CommandParameter="{Binding SelectedSession}"
                              Foreground="Red"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

            <StackPanel Grid.Row="1">
            <Expander Header="导出选项（原始数据 / 改正版本）" Margin="0,8,0,0" IsExpanded="False">
                <StackPanel Margin="8">
                    <WrapPanel Margin="0,0,0,6">
                        <TextBlock Text="数据来源:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding ExportSources}" SelectedItem="{Binding ExportSource}" Width="145" Margin="0,0,12,0"/>
                        <CheckBox Content="包含表头" IsChecked="{Binding ExportIncludeHeader}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <CheckBox Content="表头包含单位" IsChecked="{Binding ExportIncludeUnits}" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,6">
                        <TextBlock Text="开始时间:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding ExportStartTime, StringFormat=yyyy-MM-dd HH:mm:ss.fff, ValidatesOnExceptions=True}" Width="180" Margin="0,0,12,0" ToolTip="留空导出全部；格式 yyyy-MM-dd HH:mm:ss.fff"/>
                        <TextBlock Text="结束时间:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding ExportEndTime, StringFormat=yyyy-MM-dd HH:mm:ss.fff, ValidatesOnExceptions=True}" Width="180" ToolTip="留空导出全部；格式 yyyy-MM-dd HH:mm:ss.fff"/>
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock Text="通道索引:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding ExportChannelIndices}" Width="160" Margin="0,0,12,0" ToolTip="从0开始，如0,2,3；留空导出全部通道"/>
                        <TextBlock Text="小数位:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding ExportDecimalPlaces, ValidatesOnExceptions=True}" Width="55" Margin="0,0,12,0" ToolTip="0至15；留空保留全精度"/>
                        <Button Content="导出所选会话" Command="{Binding ExportSessionCommand}" CommandParameter="{Binding SelectedSession}" Padding="10,4"/>
                    </WrapPanel>
                    <TextBlock Text="Raw：原始；Corrected：改正；RawAndCorrected：并列。改正版本使用下方所选第一组配置。" Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Expander>
            <!-- 批量校正只生成独立结果；必须选择明确的磁场通道 -->
            <GroupBox Header="批量校正（可选扩展）" Margin="0,10,0,0" Padding="8">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Text="第一组:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding AvailableProfiles}"
                                  SelectedItem="{Binding SelectedCorrectionProfile}"
                                  DisplayMemberPath="Name" Width="180" Margin="0,0,12,0"/>
                        <TextBlock Text="第二组（可选）:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding AvailableProfiles}"
                                  SelectedItem="{Binding SelectedCorrectionProfileSecond}"
                                  DisplayMemberPath="Name" Width="180" Margin="0,0,8,0"
                                  ToolTip="仅改正一组三通道时可留空"/>
                        <Button Content="刷新" Command="{Binding LoadCorrectionProfilesCommand}" Padding="8,4" Margin="0,0,8,0"/>
                        <Button Content="应用校正" Command="{Binding ApplyBatchCorrectionCommand}"
                                CommandParameter="{Binding SelectedSession}"
                                Padding="10,4"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Text="第一组索引:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding FirstCorrectionChannels}" Width="110" Margin="0,0,12,0" ToolTip="从0开始，例如0,1,2；不得包含温度通道"/>
                        <TextBlock Text="第二组索引:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding SecondCorrectionChannels}" Width="110" Margin="0,0,12,0" ToolTip="例如3,4,5；两组不得重叠"/>
                        <TextBlock Text="原始数据保持不变；保存结果并导出 CSV" VerticalAlignment="Center" Foreground="#64748B"/>
                    </WrapPanel>
                    <ProgressBar Value="{Binding CorrectionProgress}" Height="6" Margin="0,4,0,0"
                                 Visibility="{Binding IsCorrecting, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </GroupBox>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
