<UserControl x:Class="MagnetometerSystem.App.Views.CalibrationPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MagnetometerSystem.App.Views"
             Background="{DynamicResource EnclosureBrush}">
    <!-- 校正页：扩展功能，按需使用。DataContext = CalibrationPage。 -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="20,0" Background="{DynamicResource EnclosureBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center"
                           Text="扩展功能，按需使用。采集与保存不依赖这里的任何配置。"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource TabRadio}" Content="正交度校正" Height="46"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource ValueEquals}, ConverterParameter=0}"/>
                    <RadioButton Style="{StaticResource TabRadio}" Content="偏移与增益" Height="46"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource ValueEquals}, ConverterParameter=1}"/>
                    <RadioButton Style="{StaticResource TabRadio}" Height="46"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource ValueEquals}, ConverterParameter=2}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="配置库"/>
                            <Border Style="{StaticResource Badge}" Margin="6,0,0,0" Padding="5,0">
                                <TextBlock Text="{Binding Ortho.SavedProfiles.Count}" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource Ink2Brush}"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Style="{StaticResource Panel}" Margin="12,0,12,12">
            <Grid>
                <views:OrthogonalityCalibrationView DataContext="{Binding Ortho}"
                    Visibility="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource DockTabVisible}, ConverterParameter=0}"/>
                <views:SensorCalibrationView DataContext="{Binding Sensor}"
                    Visibility="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource DockTabVisible}, ConverterParameter=1}"/>
                <views:CalibrationLibraryView DataContext="{Binding Ortho}"
                    Visibility="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource DockTabVisible}, ConverterParameter=2}"/>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
