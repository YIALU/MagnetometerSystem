<UserControl x:Class="MagnetometerSystem.App.Views.HistoryPlaybackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:MagnetometerSystem.App.Views"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <WrapPanel Margin="0,0,0,6">
                <TextBlock Text="历史会话" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,6"/>
                <ComboBox ItemsSource="{Binding AvailableSessions}" SelectedItem="{Binding SelectedSession}"
                          DisplayMemberPath="Name" Width="260" Margin="0,0,10,6"/>
                <Button Content="加载数据" Command="{Binding LoadSessionCommand}" Padding="10,4" Margin="0,0,10,6"/>
                <Button Content="刷新列表" Command="{Binding RefreshSessionsCommand}" Padding="10,4" Margin="0,0,10,6"/>
                <TextBlock VerticalAlignment="Center" Margin="0,0,0,6">
                    <Run Text="状态："/><Run Text="{Binding State, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
            </WrapPanel>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBlock Text="正在加载数据…" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                       FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Expander Header="已加载会话与通道" IsExpanded="False" Margin="0,0,0,6">
                <StackPanel Margin="8,6">
                    <WrapPanel>
                        <TextBlock Margin="0,0,18,4"><Run Text="会话："/><Run Text="{Binding LoadedSession.Name, Mode=OneWay}"/></TextBlock>
                        <TextBlock Margin="0,0,18,4"><Run Text="标称采样率："/><Run Text="{Binding LoadedSession.SampleRate, Mode=OneWay, StringFormat={}{0} Hz}"/></TextBlock>
                        <TextBlock Margin="0,0,18,4"><Run Text="读数："/><Run Text="{Binding TotalReadings, Mode=OneWay, StringFormat=N0}"/></TextBlock>
                        <TextBlock Margin="0,0,18,4"><Run Text="时长："/><Run Text="{Binding TotalDuration, Mode=OneWay}"/></TextBlock>
                    </WrapPanel>
                    <TextBlock Text="{Binding LoadedChannelSummary}" TextWrapping="Wrap"/>
                    <TextBlock Text="按记录时间戳播放；标称采样率不会重写时间轴。" Foreground="Gray" Margin="0,4,0,0"/>
                </StackPanel>
            </Expander>
            <Expander Header="可选正交度校正（仅作用于回放显示）" IsExpanded="False" Margin="0,0,0,6">
                <StackPanel Margin="8,6">
                    <WrapPanel>
                        <CheckBox Content="启用校正" IsChecked="{Binding IsOrthogonalityCorrectionEnabled}"
                                  VerticalAlignment="Center" Margin="0,0,15,6"/>
                        <TextBlock Text="第一组参数" VerticalAlignment="Center" Margin="0,0,6,6"/>
                        <ComboBox ItemsSource="{Binding AvailableProfiles}" SelectedItem="{Binding SelectedOrthogonalityProfile}"
                                  DisplayMemberPath="Name" Width="180" Margin="0,0,12,6"/>
                        <TextBlock Text="通道索引" VerticalAlignment="Center" Margin="0,0,6,6"/>
                        <TextBox Text="{Binding FirstChannelIndices, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,12,6"/>
                        <Button Content="刷新参数" Command="{Binding LoadOrthogonalityProfilesCommand}" Padding="8,3" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock Text="第二组参数（可选）" VerticalAlignment="Center" Margin="0,0,6,6"/>
                        <ComboBox ItemsSource="{Binding AvailableProfiles}" SelectedItem="{Binding SelectedSecondProfile}"
                                  DisplayMemberPath="Name" Width="180" Margin="0,0,12,6"/>
                        <TextBlock Text="通道索引" VerticalAlignment="Center" Margin="0,0,6,6"/>
                        <TextBox Text="{Binding SecondChannelIndices, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,12,6"/>
                        <Button Content="不使用第二组" Command="{Binding ClearSecondProfileCommand}" Padding="8,3" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <TextBlock Text="每组选择三个从 0 开始、不重复且磁场单位相同的通道索引，例如 0,1,2。缺少单位的旧会话不可启用校正；温度等辅助通道保持原值，历史数据库不变。"
                               TextWrapping="Wrap" Foreground="Gray"/>
                </StackPanel>
            </Expander>
        </StackPanel>
        <views:RealtimeChartView Grid.Row="1"
            DataContext="{Binding DataContext.RealtimeChartVM, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <DockPanel Margin="0,0,0,5">
                <TextBlock DockPanel.Dock="Left" Text="{Binding ElapsedTime}" MinWidth="85" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding TotalDuration}" MinWidth="85" TextAlignment="Right" VerticalAlignment="Center"/>
                <Slider Minimum="0" Maximum="1" Value="{Binding Progress}" IsMoveToPointEnabled="False"
                        Thumb.DragStarted="OnSeekDragStarted" Thumb.DragCompleted="OnSeekDragCompleted"
                        SmallChange="0.001" LargeChange="0.01"/>
            </DockPanel>
            <WrapPanel HorizontalAlignment="Center">
                <Button Content="播放" Command="{Binding PlayCommand}" Width="64" Margin="4" Padding="4"/>
                <Button Content="暂停" Command="{Binding PauseCommand}" Width="64" Margin="4" Padding="4"/>
                <Button Content="停止" Command="{Binding StopCommand}" Width="64" Margin="4" Padding="4"/>
                <TextBlock Text="速度" VerticalAlignment="Center" Margin="16,4,6,4"/>
                <ComboBox ItemsSource="{Binding AvailableSpeeds}" SelectedItem="{Binding PlaybackSpeed}" Width="75" VerticalAlignment="Center">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0}x}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock VerticalAlignment="Center" Margin="16,4,0,4">
                    <Run Text="{Binding CurrentIndex, Mode=OneWay, StringFormat=N0}"/><Run Text=" / "/>
                    <Run Text="{Binding TotalReadings, Mode=OneWay, StringFormat=N0}"/>
                </TextBlock>
                <TextBlock Text="{Binding CurrentTime}" VerticalAlignment="Center" Margin="16,4,0,4"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>
